<?xml version='1.0' encoding='utf-8'?>
<resource>
  <object class="wxDialog" name="num_dialog">
    <title>Numbering and Bullets</title>
    <style>wxDEFAULT_DIALOG_STYLE</style>
    <bg>#e8ecf2</bg>
    <object class="wxBoxSizer">
      <orient>wxVERTICAL</orient>
      <object class="sizeritem">
        <option>0</option>
        <flag>wxLEFT|wxRIGHT|wxTOP</flag>
        <border>12</border>
        <object class="wxBoxSizer">
          <orient>wxHORIZONTAL</orient>
          <object class="spacer">
            <size>8,1</size>
            <option>0</option>
          </object>
          <object class="sizeritem">
            <option>0</option>
            <flag>wxALIGN_BOTTOM</flag>
            <border>0</border>
            <object class="wxButton" name="num_tab_0">
              <label>Bullets</label>
              <size>88,30</size>
              <style>wxBU_EXACTFIT|wxBORDER_NONE</style>
              <bg>#e8ecf2</bg>
            </object>
          </object>
          <object class="sizeritem">
            <option>0</option>
            <flag>wxALIGN_BOTTOM</flag>
            <border>0</border>
            <object class="wxButton" name="num_tab_1">
              <label>Numbering</label>
              <size>88,30</size>
              <style>wxBU_EXACTFIT|wxBORDER_NONE</style>
              <bg>#e8ecf2</bg>
            </object>
          </object>
        </object>
      </object>
      <object class="sizeritem">
        <option>1</option>
        <flag>wxEXPAND|wxLEFT|wxRIGHT</flag>
        <border>12</border>
        <object class="wxPanel" name="num_card">
          <bg>#ffffff</bg>
          <object class="wxBoxSizer">
            <orient>wxVERTICAL</orient>
            <object class="sizeritem">
              <option>1</option>
              <flag>wxEXPAND|wxALL</flag>
              <border>16</border>
              <object class="wxBoxSizer">
                <orient>wxVERTICAL</orient>
                <object class="sizeritem">
                  <option>1</option>
                  <flag>wxEXPAND</flag>
                  <border>0</border>
                  <object class="wxPanel" name="num_page_0">
                    <bg>#ffffff</bg>
                    <object class="wxBoxSizer">
                      <orient>wxVERTICAL</orient>
                      <object class="sizeritem">
                        <option>0</option>
                        <flag>wxEXPAND</flag>
                        <border>0</border>
                        <object class="wxBoxSizer">
                          <orient>wxHORIZONTAL</orient>
                          <object class="sizeritem">
                            <option>0</option>
                            <flag>wxALIGN_CENTER_VERTICAL|wxRIGHT</flag>
                            <border>10</border>
                            <object class="wxStaticText" name="i18n_control_4">
                              <label>Bullet library</label>
                              <fg>#1d3d78</fg>
                              <font>
                                <weight>bold</weight>
                              </font>
                            </object>
                          </object>
                          <object class="sizeritem">
                            <option>1</option>
                            <flag>wxALIGN_CENTER_VERTICAL</flag>
                            <border>0</border>
                            <object class="wxPanel">
                              <size>-1,1</size>
                              <bg>#dfe4ec</bg>
                            </object>
                          </object>
                        </object>
                      </object>
                      <object class="sizeritem">
                        <option>1</option>
                        <flag>wxEXPAND|wxTOP</flag>
                        <border>10</border>
                        <object class="wxBoxSizer">
                          <orient>wxHORIZONTAL</orient>
                          <object class="spacer">
                            <size>12,1</size>
                            <option>0</option>
                          </object>
                          <object class="sizeritem">
                            <option>1</option>
                            <flag>wxEXPAND</flag>
                            <border>0</border>
                            <object class="wxBoxSizer">
                              <orient>wxVERTICAL</orient>
                              <object class="sizeritem">
                                <option>1</option>
                                <flag>wxEXPAND</flag>
                                <border>0</border>
                                <object class="wxPanel" name="num_bullets">
                                  <bg>#ffffff</bg>
                                  <size>440,230</size>
                                  <style>wxWANTS_CHARS|wxFULL_REPAINT_ON_RESIZE</style>
                                </object>
                              </object>
                              <object class="sizeritem">
                                <option>0</option>
                                <flag>wxTOP</flag>
                                <border>12</border>
                                <object class="wxBoxSizer">
                                  <orient>wxHORIZONTAL</orient>
                                  <object class="sizeritem">
                                    <option>0</option>
                                    <flag>wxEXPAND</flag>
                                    <border>0</border>
                                    <object class="wxButton" name="num_define_bullet">
                                      <label>Define New Bullet…</label>
                                      <size>150,28</size>
                                    </object>
                                  </object>
                                </object>
                              </object>
                            </object>
                          </object>
                        </object>
                      </object>
                    </object>
                  </object>
                </object>
                <object class="sizeritem">
                  <option>1</option>
                  <flag>wxEXPAND</flag>
                  <border>0</border>
                  <object class="wxPanel" name="num_page_1">
                    <bg>#ffffff</bg>
                    <hidden>1</hidden>
                    <object class="wxBoxSizer">
                      <orient>wxVERTICAL</orient>
                      <object class="sizeritem">
                        <option>0</option>
                        <flag>wxEXPAND</flag>
                        <border>0</border>
                        <object class="wxBoxSizer">
                          <orient>wxHORIZONTAL</orient>
                          <object class="sizeritem">
                            <option>0</option>
                            <flag>wxALIGN_CENTER_VERTICAL|wxRIGHT</flag>
                            <border>10</border>
                            <object class="wxStaticText" name="i18n_control_6">
                              <label>Numbering library</label>
                              <fg>#1d3d78</fg>
                              <font>
                                <weight>bold</weight>
                              </font>
                            </object>
                          </object>
                          <object class="sizeritem">
                            <option>1</option>
                            <flag>wxALIGN_CENTER_VERTICAL</flag>
                            <border>0</border>
                            <object class="wxPanel">
                              <size>-1,1</size>
                              <bg>#dfe4ec</bg>
                            </object>
                          </object>
                        </object>
                      </object>
                      <object class="sizeritem">
                        <option>1</option>
                        <flag>wxEXPAND|wxTOP</flag>
                        <border>10</border>
                        <object class="wxBoxSizer">
                          <orient>wxHORIZONTAL</orient>
                          <object class="spacer">
                            <size>12,1</size>
                            <option>0</option>
                          </object>
                          <object class="sizeritem">
                            <option>1</option>
                            <flag>wxEXPAND</flag>
                            <border>0</border>
                            <object class="wxBoxSizer">
                              <orient>wxVERTICAL</orient>
                              <object class="sizeritem">
                                <option>1</option>
                                <flag>wxEXPAND</flag>
                                <border>0</border>
                                <object class="wxPanel" name="num_numbers">
                                  <bg>#ffffff</bg>
                                  <size>440,230</size>
                                  <style>wxWANTS_CHARS|wxFULL_REPAINT_ON_RESIZE</style>
                                </object>
                              </object>
                            </object>
                          </object>
                        </object>
                      </object>
                      <object class="sizeritem">
                        <option>0</option>
                        <flag>wxEXPAND|wxTOP</flag>
                        <border>24</border>
                        <object class="wxBoxSizer">
                          <orient>wxHORIZONTAL</orient>
                          <object class="sizeritem">
                            <option>0</option>
                            <flag>wxALIGN_CENTER_VERTICAL|wxRIGHT</flag>
                            <border>10</border>
                            <object class="wxStaticText" name="i18n_control_7">
                              <label>List</label>
                              <fg>#1d3d78</fg>
                              <font>
                                <weight>bold</weight>
                              </font>
                            </object>
                          </object>
                          <object class="sizeritem">
                            <option>1</option>
                            <flag>wxALIGN_CENTER_VERTICAL</flag>
                            <border>0</border>
                            <object class="wxPanel">
                              <size>-1,1</size>
                              <bg>#dfe4ec</bg>
                            </object>
                          </object>
                        </object>
                      </object>
                      <object class="sizeritem">
                        <option>0</option>
                        <flag>wxEXPAND|wxTOP</flag>
                        <border>10</border>
                        <object class="wxBoxSizer">
                          <orient>wxHORIZONTAL</orient>
                          <object class="spacer">
                            <size>12,1</size>
                            <option>0</option>
                          </object>
                          <object class="sizeritem">
                            <option>1</option>
                            <flag>wxEXPAND</flag>
                            <border>0</border>
                            <object class="wxBoxSizer">
                              <orient>wxVERTICAL</orient>
                              <object class="sizeritem">
                                <option>0</option>
                                <flag>wxEXPAND</flag>
                                <border>0</border>
                                <object class="wxFlexGridSizer">
                                  <rows>0</rows>
                                  <cols>2</cols>
                                  <vgap>8</vgap>
                                  <hgap>32</hgap>
                                  <growablecols />
                                  <object class="sizeritem">
                                    <option>0</option>
                                    <flag>wxALIGN_CENTER_VERTICAL</flag>
                                    <border>0</border>
                                    <object class="wxRadioButton" name="num_restart">
                                      <label>Restart numbering</label>
                                      <style>wxRB_GROUP</style>
                                    </object>
                                  </object>
                                  <object class="sizeritem">
                                    <option>0</option>
                                    <flag>wxALIGN_CENTER_VERTICAL</flag>
                                    <border>0</border>
                                    <object class="wxRadioButton" name="num_continue">
                                      <label>Continue previous list</label>
                                    </object>
                                  </object>
                                </object>
                              </object>
                              <object class="sizeritem">
                                <option>0</option>
                                <flag>wxEXPAND|wxTOP</flag>
                                <border>10</border>
                                <object class="wxFlexGridSizer">
                                  <rows>0</rows>
                                  <cols>4</cols>
                                  <vgap>8</vgap>
                                  <hgap>12</hgap>
                                  <growablecols />
                                  <object class="sizeritem">
                                    <option>0</option>
                                    <flag>wxALIGN_CENTER_VERTICAL</flag>
                                    <border>0</border>
                                    <object class="wxStaticText" name="i18n_control_10">
                                      <label>Start at:</label>
                                      <size>70,-1</size>
                                      <fg>#243042</fg>
                                    </object>
                                  </object>
                                  <object class="sizeritem">
                                    <option>0</option>
                                    <flag>wxALIGN_CENTER_VERTICAL</flag>
                                    <border>0</border>
                                    <object class="wxSpinCtrlDouble" name="num_start">
                                      <size>90,28</size>
                                      <min>1</min>
                                      <max>32767</max>
                                      <inc>1</inc>
                                      <digits>0</digits>
                                      <value>1</value>
                                    </object>
                                    <minsize>110,-1</minsize>
                                  </object>
                                  <object class="sizeritem">
                                    <option>0</option>
                                    <flag>wxALIGN_CENTER_VERTICAL|wxLEFT</flag>
                                    <border>24</border>
                                    <object class="wxStaticText" name="i18n_control_11">
                                      <label>Level:</label>
                                      <size>50,-1</size>
                                      <fg>#243042</fg>
                                    </object>
                                  </object>
                                  <object class="sizeritem">
                                    <option>0</option>
                                    <flag>wxALIGN_CENTER_VERTICAL</flag>
                                    <border>0</border>
                                    <object class="wxComboBox" name="num_level">
                                      <size>80,28</size>
                                      <style>wxCB_READONLY</style>
                                      <content>
                                        <item>1</item>
                                        <item>2</item>
                                        <item>3</item>
                                        <item>4</item>
                                        <item>5</item>
                                        <item>6</item>
                                        <item>7</item>
                                        <item>8</item>
                                        <item>9</item>
                                      </content>
                                      <selection>0</selection>
                                    </object>
                                  </object>
                                </object>
                              </object>
                              <object class="sizeritem">
                                <option>0</option>
                                <flag>wxTOP</flag>
                                <border>12</border>
                                <object class="wxBoxSizer">
                                  <orient>wxHORIZONTAL</orient>
                                  <object class="sizeritem">
                                    <option>0</option>
                                    <flag>wxEXPAND</flag>
                                    <border>0</border>
                                    <object class="wxButton" name="num_define_number">
                                      <label>Define New Number Format…</label>
                                      <size>200,28</size>
                                    </object>
                                  </object>
                                </object>
                              </object>
                            </object>
                          </object>
                        </object>
                      </object>
                    </object>
                  </object>
                </object>
              </object>
            </object>
          </object>
        </object>
      </object>
      <object class="sizeritem">
        <option>0</option>
        <flag>wxEXPAND|wxALL</flag>
        <border>12</border>
        <object class="wxBoxSizer">
          <orient>wxHORIZONTAL</orient>
          <object class="spacer">
            <size>1,1</size>
            <option>1</option>
          </object>
          <object class="sizeritem">
            <option>0</option>
            <flag>wxALIGN_CENTER_VERTICAL</flag>
            <border>0</border>
            <object class="wxButton" name="num_ok">
              <label>OK</label>
              <size>88,28</size>
              <style>wxBU_EXACTFIT|wxBU_NOTEXT|wxBORDER_NONE</style>
              <default>1</default>
            </object>
          </object>
          <object class="sizeritem">
            <option>0</option>
            <flag>wxALIGN_CENTER_VERTICAL|wxLEFT</flag>
            <border>8</border>
            <object class="wxButton" name="num_cancel">
              <label>Cancel</label>
              <size>88,28</size>
              <style>wxBU_EXACTFIT|wxBU_NOTEXT|wxBORDER_NONE</style>
            </object>
          </object>
        </object>
      </object>
    </object>
  </object>
</resource>