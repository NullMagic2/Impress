                                      <object class="sizeritem">
                                        <option>0</option>
                                        <flag>wxALIGN_CENTER_VERTICAL|wxLEFT</flag>
                                        <border>6</border>
                                        <object class="wxStaticText" name="i18n_control_34">
                                          <label>cm</label>
