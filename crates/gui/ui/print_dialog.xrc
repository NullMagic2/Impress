<?xml version='1.0' encoding='utf-8'?>
<resource>
  <object class="wxDialog" name="print_dialog">
    <title>Print</title>
    <style>wxDEFAULT_DIALOG_STYLE</style>
    <bg>#e8ecf2</bg>
    <object class="wxBoxSizer">
      <orient>wxVERTICAL</orient>
      <object class="sizeritem">
        <option>1</option>
        <flag>wxEXPAND|wxLEFT|wxRIGHT|wxTOP</flag>
        <border>12</border>
        <object class="wxPanel" name="print_card">
          <bg>#ffffff</bg>
          <object class="wxBoxSizer">
            <orient>wxVERTICAL</orient>
            <object class="sizeritem">
              <option>1</option>
              <flag>wxEXPAND|wxALL</flag>
              <border>16</border>
              <object class="wxBoxSizer">
                <orient>wxVERTICAL</orient>
                <object class="sizeritem">
                  <option>1</option>
                  <flag>wxEXPAND</flag>
                  <border>0</border>
                  <object class="wxBoxSizer">
                    <orient>wxHORIZONTAL</orient>
                    <object class="sizeritem">
                      <option>0</option>
                      <flag>wxEXPAND|wxRIGHT</flag>
                      <border>20</border>
                      <object class="wxBoxSizer">
                        <orient>wxVERTICAL</orient>
                        <object class="sizeritem">
                          <option>0</option>
                          <flag>wxBOTTOM</flag>
                          <border>6</border>
                          <object class="wxStaticText" name="print_preview_caption">
                            <label>Preview</label>
                            <fg>#6b778a</fg>
                          </object>
                        </object>
                        <object class="sizeritem">
                          <option>1</option>
                          <flag>wxEXPAND</flag>
                          <border>0</border>
                          <object class="wxPanel" name="print_preview">
                            <bg>#eef2f7</bg>
                            <size>250,340</size>
                            <style>wxWANTS_CHARS|wxFULL_REPAINT_ON_RESIZE</style>
                          </object>
                        </object>
                      </object>
                    </object>
                    <object class="sizeritem">
                      <option>1</option>
                      <flag>wxEXPAND</flag>
                      <border>0</border>
                      <object class="wxBoxSizer">
                        <orient>wxVERTICAL</orient>
                        <object class="sizeritem">
                          <option>0</option>
                          <flag>wxEXPAND</flag>
                          <border>0</border>
                          <object class="wxBoxSizer">
                            <orient>wxHORIZONTAL</orient>
                            <object class="sizeritem">
                              <option>0</option>
                              <flag>wxALIGN_CENTER_VERTICAL|wxRIGHT</flag>
                              <border>10</border>
                              <object class="wxStaticText" name="i18n_control_3">
                                <label>Printer</label>
                                <fg>#1d3d78</fg>
                                <font>
                                  <weight>bold</weight>
                                </font>
                              </object>
                            </object>
                            <object class="sizeritem">
                              <option>1</option>
                              <flag>wxALIGN_CENTER_VERTICAL</flag>
                              <border>0</border>
                              <object class="wxPanel">
                                <size>-1,1</size>
                                <bg>#dfe4ec</bg>
                              </object>
                            </object>
                          </object>
                        </object>
                        <object class="sizeritem">
                          <option>0</option>
                          <flag>wxEXPAND|wxTOP</flag>
                          <border>10</border>
                          <object class="wxBoxSizer">
                            <orient>wxHORIZONTAL</orient>
                            <object class="spacer">
                              <size>12,1</size>
                              <option>0</option>
                            </object>
                            <object class="sizeritem">
                              <option>1</option>
                              <flag>wxEXPAND</flag>
                              <border>0</border>
                              <object class="wxBoxSizer">
                                <orient>wxVERTICAL</orient>
                                <object class="sizeritem">
                                  <option>0</option>
                                  <flag>wxEXPAND</flag>
                                  <border>0</border>
                                  <object class="wxStaticText" name="print_printer">
                                    <label>You choose the printer and paper in the next step.</label>
                                    <fg>#6b778a</fg>
                                  </object>
                                </object>
                              </object>
                            </object>
                          </object>
                        </object>
                        <object class="sizeritem">
                          <option>0</option>
                          <flag>wxEXPAND|wxTOP</flag>
                          <border>24</border>
                          <object class="wxBoxSizer">
                            <orient>wxHORIZONTAL</orient>
                            <object class="sizeritem">
                              <option>0</option>
                              <flag>wxALIGN_CENTER_VERTICAL|wxRIGHT</flag>
                              <border>10</border>
                              <object class="wxStaticText" name="i18n_control_5">
                                <label>Pages</label>
                                <fg>#1d3d78</fg>
                                <font>
                                  <weight>bold</weight>
                                </font>
                              </object>
                            </object>
                            <object class="sizeritem">
                              <option>1</option>
                              <flag>wxALIGN_CENTER_VERTICAL</flag>
                              <border>0</border>
                              <object class="wxPanel">
                                <size>-1,1</size>
                                <bg>#dfe4ec</bg>
                              </object>
                            </object>
                          </object>
                        </object>
                        <object class="sizeritem">
                          <option>0</option>
                          <flag>wxEXPAND|wxTOP</flag>
                          <border>10</border>
                          <object class="wxBoxSizer">
                            <orient>wxHORIZONTAL</orient>
                            <object class="spacer">
                              <size>12,1</size>
                              <option>0</option>
                            </object>
                            <object class="sizeritem">
                              <option>1</option>
                              <flag>wxEXPAND</flag>
                              <border>0</border>
                              <object class="wxBoxSizer">
                                <orient>wxVERTICAL</orient>
                                <object class="sizeritem">
                                  <option>0</option>
                                  <flag>wxBOTTOM</flag>
                                  <border>6</border>
                                  <object class="wxRadioButton" name="print_all">
                                    <label>All pages</label>
                                    <style>wxRB_GROUP</style>
                                  </object>
                                </object>
                                <object class="sizeritem">
                                  <option>0</option>
                                  <flag>wxBOTTOM</flag>
                                  <border>6</border>
                                  <object class="wxRadioButton" name="print_current">
                                    <label>Current page</label>
                                  </object>
                                </object>
                                <object class="sizeritem">
                                  <option>0</option>
                                  <flag>wxEXPAND</flag>
                                  <border>0</border>
                                  <object class="wxBoxSizer">
                                    <orient>wxHORIZONTAL</orient>
                                    <object class="sizeritem">
                                      <option>0</option>
                                      <flag>wxALIGN_CENTER_VERTICAL|wxRIGHT</flag>
                                      <border>10</border>
                                      <object class="wxRadioButton" name="print_range">
                                        <label>Pages</label>
                                      </object>
                                    </object>
                                    <object class="sizeritem">
                                      <option>1</option>
                                      <flag>wxALIGN_CENTER_VERTICAL</flag>
                                      <border>0</border>
                                      <object class="wxTextCtrl" name="print_pages">
                                        <size>150,28</size>
                                        <tooltip>Page numbers and ranges, for example 1, 3-5</tooltip>
                                        <hint>e.g. 1, 3-5</hint>
                                      </object>
                                    </object>
                                  </object>
                                </object>
                                <object class="sizeritem">
                                  <option>0</option>
                                  <flag>wxTOP</flag>
                                  <border>8</border>
                                  <object class="wxStaticText" name="print_summary">
                                    <label>All 1 page</label>
                                    <fg>#6b778a</fg>
                                  </object>
                                </object>
                              </object>
                            </object>
                          </object>
                        </object>
                        <object class="sizeritem">
                          <option>0</option>
                          <flag>wxEXPAND|wxTOP</flag>
                          <border>24</border>
                          <object class="wxBoxSizer">
                            <orient>wxHORIZONTAL</orient>
                            <object class="sizeritem">
                              <option>0</option>
                              <flag>wxALIGN_CENTER_VERTICAL|wxRIGHT</flag>
                              <border>10</border>
                              <object class="wxStaticText" name="i18n_control_11">
                                <label>Copies</label>
                                <fg>#1d3d78</fg>
                                <font>
                                  <weight>bold</weight>
                                </font>
                              </object>
                            </object>
                            <object class="sizeritem">
                              <option>1</option>
                              <flag>wxALIGN_CENTER_VERTICAL</flag>
                              <border>0</border>
                              <object class="wxPanel">
                                <size>-1,1</size>
                                <bg>#dfe4ec</bg>
                              </object>
                            </object>
                          </object>
                        </object>
                        <object class="sizeritem">
                          <option>0</option>
                          <flag>wxEXPAND|wxTOP</flag>
                          <border>10</border>
                          <object class="wxBoxSizer">
                            <orient>wxHORIZONTAL</orient>
                            <object class="spacer">
                              <size>12,1</size>
                              <option>0</option>
                            </object>
                            <object class="sizeritem">
                              <option>1</option>
                              <flag>wxEXPAND</flag>
                              <border>0</border>
                              <object class="wxBoxSizer">
                                <orient>wxVERTICAL</orient>
                                <object class="sizeritem">
                                  <option>0</option>
                                  <flag>wxEXPAND</flag>
                                  <border>0</border>
                                  <object class="wxBoxSizer">
                                    <orient>wxHORIZONTAL</orient>
                                    <object class="sizeritem">
                                      <option>0</option>
                                      <flag>wxALIGN_CENTER_VERTICAL</flag>
                                      <border>0</border>
                                      <object class="wxSpinCtrlDouble" name="print_copies">
                                        <size>124,-1</size>
                                        <min>1</min>
                                        <max>99</max>
                                        <inc>1</inc>
                                        <digits>0</digits>
                                        <value>1</value>
                                      </object>
                                    </object>
                                    <object class="sizeritem">
                                      <option>0</option>
                                      <flag>wxALIGN_CENTER_VERTICAL|wxLEFT</flag>
                                      <border>16</border>
                                      <object class="wxCheckBox" name="print_collate">
                                        <label>Collate</label>
                                      </object>
                                    </object>
                                  </object>
                                </object>
                              </object>
                            </object>
                          </object>
                        </object>
                        <object class="sizeritem">
                          <option>0</option>
                          <flag>wxEXPAND|wxTOP</flag>
                          <border>24</border>
                          <object class="wxBoxSizer">
                            <orient>wxHORIZONTAL</orient>
                            <object class="sizeritem">
                              <option>0</option>
                              <flag>wxALIGN_CENTER_VERTICAL|wxRIGHT</flag>
                              <border>10</border>
                              <object class="wxStaticText" name="i18n_control_13">
                                <label>Scale</label>
                                <fg>#1d3d78</fg>
                                <font>
                                  <weight>bold</weight>
                                </font>
                              </object>
                            </object>
                            <object class="sizeritem">
                              <option>1</option>
                              <flag>wxALIGN_CENTER_VERTICAL</flag>
                              <border>0</border>
                              <object class="wxPanel">
                                <size>-1,1</size>
                                <bg>#dfe4ec</bg>
                              </object>
                            </object>
                          </object>
                        </object>
                        <object class="sizeritem">
                          <option>0</option>
                          <flag>wxEXPAND|wxTOP</flag>
                          <border>10</border>
                          <object class="wxBoxSizer">
                            <orient>wxHORIZONTAL</orient>
                            <object class="spacer">
                              <size>12,1</size>
                              <option>0</option>
                            </object>
                            <object class="sizeritem">
                              <option>1</option>
                              <flag>wxEXPAND</flag>
                              <border>0</border>
                              <object class="wxBoxSizer">
                                <orient>wxVERTICAL</orient>
                                <object class="sizeritem">
                                  <option>0</option>
                                  <flag>wxBOTTOM</flag>
                                  <border>6</border>
                                  <object class="wxRadioButton" name="print_fit">
                                    <label>Fit each page to the paper</label>
                                    <style>wxRB_GROUP</style>
                                  </object>
                                </object>
                                <object class="sizeritem">
                                  <option>0</option>
                                  <flag>wxEXPAND</flag>
                                  <border>0</border>
                                  <object class="wxRadioButton" name="print_actual">
                                    <label>Actual size (100%)</label>
                                  </object>
                                </object>
                              </object>
                            </object>
                          </object>
                        </object>
                      </object>
                    </object>
                  </object>
                </object>
              </object>
            </object>
          </object>
        </object>
      </object>
      <object class="sizeritem">
        <option>0</option>
        <flag>wxEXPAND|wxLEFT|wxRIGHT|wxTOP</flag>
        <border>12</border>
        <object class="wxStaticLine" />
      </object>
      <object class="sizeritem">
        <option>0</option>
        <flag>wxEXPAND|wxALL</flag>
        <border>12</border>
        <object class="wxBoxSizer">
          <orient>wxHORIZONTAL</orient>
          <object class="spacer">
            <size>1,1</size>
            <option>1</option>
          </object>
          <object class="sizeritem">
            <option>0</option>
            <flag>wxALIGN_CENTER_VERTICAL</flag>
            <border>0</border>
            <object class="wxGridBagSizer">
              <hgap>12</hgap>
              <object class="sizeritem">
                <option>0</option>
                <flag>wxALIGN_CENTER_VERTICAL</flag>
                <border>0</border>
                <object class="wxButton" name="print_cancel">
                  <label>Cancel</label>
                </object>
                <minsize>96,-1</minsize>
                <cellpos platform="unix|mac">0,0</cellpos>
                <cellpos platform="msw">0,1</cellpos>
              </object>
              <object class="sizeritem">
                <option>0</option>
                <flag>wxALIGN_CENTER_VERTICAL</flag>
                <border>0</border>
                <object class="wxButton" name="print_ok">
                  <label>Print…</label>
                  <default>1</default>
                </object>
                <minsize>96,-1</minsize>
                <cellpos platform="unix|mac">0,1</cellpos>
                <cellpos platform="msw">0,0</cellpos>
              </object>
            </object>
          </object>
          <object class="spacer">
            <size>1,1</size>
            <option>1</option>
          </object>
        </object>
      </object>
    </object>
  </object>
</resource>