<?xml version='1.0' encoding='utf-8'?>
<resource>
  <object class="wxDialog" name="pdf_export_dialog">
    <title>Export PDF</title>
    <style>wxDEFAULT_DIALOG_STYLE</style>
    <bg>#e8ecf2</bg>
    <object class="wxBoxSizer">
      <orient>wxVERTICAL</orient>
      <object class="sizeritem">
        <option>1</option>
        <flag>wxEXPAND|wxLEFT|wxRIGHT|wxTOP</flag>
        <border>12</border>
        <object class="wxPanel" name="pdf_export_card">
          <bg>#ffffff</bg>
          <object class="wxBoxSizer">
            <orient>wxVERTICAL</orient>
            <object class="sizeritem">
              <option>1</option>
              <flag>wxEXPAND|wxALL</flag>
              <border>16</border>
              <object class="wxBoxSizer">
                <orient>wxVERTICAL</orient>
                <object class="sizeritem">
                  <option>1</option>
                  <flag>wxEXPAND</flag>
                  <border>0</border>
                  <object class="wxBoxSizer">
                    <orient>wxHORIZONTAL</orient>
                    <object class="sizeritem">
                      <option>0</option>
                      <flag>wxEXPAND|wxRIGHT</flag>
                      <border>20</border>
                      <object class="wxBoxSizer">
                        <orient>wxVERTICAL</orient>
                        <object class="sizeritem">
                          <option>0</option>
                          <flag>wxBOTTOM</flag>
                          <border>6</border>
                          <object class="wxStaticText" name="pdf_export_preview_caption">
                            <label>Preview</label>
                            <fg>#6b778a</fg>
                          </object>
                        </object>
                        <object class="sizeritem">
                          <option>1</option>
                          <flag>wxEXPAND</flag>
                          <border>0</border>
                          <object class="wxPanel" name="pdf_export_preview">
                            <bg>#eef2f7</bg>
                            <size>250,340</size>
                            <style>wxWANTS_CHARS|wxFULL_REPAINT_ON_RESIZE</style>
                          </object>
                        </object>
                      </object>
                    </object>
                    <object class="sizeritem">
                      <option>1</option>
                      <flag>wxEXPAND</flag>
                      <border>0</border>
                      <object class="wxBoxSizer">
                        <orient>wxVERTICAL</orient>
                        <object class="sizeritem">
                          <option>0</option>
                          <flag>wxEXPAND</flag>
                          <border>0</border>
                          <object class="wxBoxSizer">
                            <orient>wxHORIZONTAL</orient>
                            <object class="sizeritem">
                              <option>0</option>
                              <flag>wxALIGN_CENTER_VERTICAL|wxRIGHT</flag>
                              <border>10</border>
                              <object class="wxStaticText" name="i18n_control_3">
                                <label>Save to</label>
                                <fg>#1d3d78</fg>
                                <font>
                                  <weight>bold</weight>
                                </font>
                              </object>
                            </object>
                            <object class="sizeritem">
                              <option>1</option>
                              <flag>wxALIGN_CENTER_VERTICAL</flag>
                              <border>0</border>
                              <object class="wxPanel">
                                <size>-1,1</size>
                                <bg>#dfe4ec</bg>
                              </object>
                            </object>
                          </object>
                        </object>
                        <object class="sizeritem">
                          <option>0</option>
                          <flag>wxEXPAND|wxTOP</flag>
                          <border>10</border>
                          <object class="wxBoxSizer">
                            <orient>wxHORIZONTAL</orient>
                            <object class="spacer">
                              <size>12,1</size>
                              <option>0</option>
                            </object>
                            <object class="sizeritem">
                              <option>1</option>
                              <flag>wxEXPAND</flag>
                              <border>0</border>
                              <object class="wxBoxSizer">
                                <orient>wxVERTICAL</orient>
                                <object class="sizeritem">
                                  <option>0</option>
                                  <flag>wxEXPAND</flag>
                                  <border>0</border>
                                  <object class="wxBoxSizer">
                                    <orient>wxHORIZONTAL</orient>
                                    <object class="sizeritem">
                                      <option>1</option>
                                      <flag>wxALIGN_CENTER_VERTICAL</flag>
                                      <border>0</border>
                                      <object class="wxTextCtrl" name="pdf_export_path">
                                        <size>300,28</size>
                                      </object>
                                    </object>
                                    <object class="sizeritem">
                                      <option>0</option>
                                      <flag>wxALIGN_CENTER_VERTICAL|wxLEFT</flag>
                                      <border>8</border>
                                      <object class="wxButton" name="pdf_export_browse">
                                        <label>Browse…</label>
                                        <size>92,28</size>
                                        <style>wxBU_EXACTFIT|wxBU_NOTEXT|wxBORDER_NONE</style>
                                      </object>
                                    </object>
                                  </object>
                                </object>
                              </object>
                            </object>
                          </object>
                        </object>
                        <object class="sizeritem">
                          <option>0</option>
                          <flag>wxEXPAND|wxTOP</flag>
                          <border>24</border>
                          <object class="wxBoxSizer">
                            <orient>wxHORIZONTAL</orient>
                            <object class="sizeritem">
                              <option>0</option>
                              <flag>wxALIGN_CENTER_VERTICAL|wxRIGHT</flag>
                              <border>10</border>
                              <object class="wxStaticText" name="i18n_control_5">
                                <label>Pages</label>
                                <fg>#1d3d78</fg>
                                <font>
                                  <weight>bold</weight>
                                </font>
                              </object>
                            </object>
                            <object class="sizeritem">
                              <option>1</option>
                              <flag>wxALIGN_CENTER_VERTICAL</flag>
                              <border>0</border>
                              <object class="wxPanel">
                                <size>-1,1</size>
                                <bg>#dfe4ec</bg>
                              </object>
                            </object>
                          </object>
                        </object>
                        <object class="sizeritem">
                          <option>0</option>
                          <flag>wxEXPAND|wxTOP</flag>
                          <border>10</border>
                          <object class="wxBoxSizer">
                            <orient>wxHORIZONTAL</orient>
                            <object class="spacer">
                              <size>12,1</size>
                              <option>0</option>
                            </object>
                            <object class="sizeritem">
                              <option>1</option>
                              <flag>wxEXPAND</flag>
                              <border>0</border>
                              <object class="wxBoxSizer">
                                <orient>wxVERTICAL</orient>
                                <object class="sizeritem">
                                  <option>0</option>
                                  <flag>wxBOTTOM</flag>
                                  <border>6</border>
                                  <object class="wxRadioButton" name="pdf_export_all">
                                    <label>All pages</label>
                                    <style>wxRB_GROUP</style>
                                  </object>
                                </object>
                                <object class="sizeritem">
                                  <option>0</option>
                                  <flag>wxBOTTOM</flag>
                                  <border>6</border>
                                  <object class="wxRadioButton" name="pdf_export_current">
                                    <label>Current page</label>
                                  </object>
                                </object>
                                <object class="sizeritem">
                                  <option>0</option>
                                  <flag>wxEXPAND</flag>
                                  <border>0</border>
                                  <object class="wxBoxSizer">
                                    <orient>wxHORIZONTAL</orient>
                                    <object class="sizeritem">
                                      <option>0</option>
                                      <flag>wxALIGN_CENTER_VERTICAL|wxRIGHT</flag>
                                      <border>10</border>
                                      <object class="wxRadioButton" name="pdf_export_range">
                                        <label>Pages</label>
                                      </object>
                                    </object>
                                    <object class="sizeritem">
                                      <option>1</option>
                                      <flag>wxALIGN_CENTER_VERTICAL</flag>
                                      <border>0</border>
                                      <object class="wxTextCtrl" name="pdf_export_pages">
                                        <size>150,28</size>
                                        <tooltip>Page numbers and ranges, for example 1, 3-5</tooltip>
                                        <hint>e.g. 1, 3-5</hint>
                                      </object>
                                    </object>
                                  </object>
                                </object>
                                <object class="sizeritem">
                                  <option>0</option>
                                  <flag>wxTOP</flag>
                                  <border>8</border>
                                  <object class="wxStaticText" name="pdf_export_summary">
                                    <label>All 1 page</label>
                                    <fg>#6b778a</fg>
                                  </object>
                                </object>
                              </object>
                            </object>
                          </object>
                        </object>
                        <object class="sizeritem">
                          <option>0</option>
                          <flag>wxEXPAND|wxTOP</flag>
                          <border>24</border>
                          <object class="wxBoxSizer">
                            <orient>wxHORIZONTAL</orient>
                            <object class="sizeritem">
                              <option>0</option>
                              <flag>wxALIGN_CENTER_VERTICAL|wxRIGHT</flag>
                              <border>10</border>
                              <object class="wxStaticText" name="i18n_control_11">
                                <label>Document properties</label>
                                <fg>#1d3d78</fg>
                                <font>
                                  <weight>bold</weight>
                                </font>
                              </object>
                            </object>
                            <object class="sizeritem">
                              <option>1</option>
                              <flag>wxALIGN_CENTER_VERTICAL</flag>
                              <border>0</border>
                              <object class="wxPanel">
                                <size>-1,1</size>
                                <bg>#dfe4ec</bg>
                              </object>
                            </object>
                          </object>
                        </object>
                        <object class="sizeritem">
                          <option>0</option>
                          <flag>wxEXPAND|wxTOP</flag>
                          <border>10</border>
                          <object class="wxBoxSizer">
                            <orient>wxHORIZONTAL</orient>
                            <object class="spacer">
                              <size>12,1</size>
                              <option>0</option>
                            </object>
                            <object class="sizeritem">
                              <option>1</option>
                              <flag>wxEXPAND</flag>
                              <border>0</border>
                              <object class="wxBoxSizer">
                                <orient>wxVERTICAL</orient>
                                <object class="sizeritem">
                                  <option>0</option>
                                  <flag>wxEXPAND</flag>
                                  <border>0</border>
                                  <object class="wxFlexGridSizer">
                                    <rows>0</rows>
                                    <cols>2</cols>
                                    <vgap>8</vgap>
                                    <hgap>12</hgap>
                                    <growablecols>1</growablecols>
                                    <object class="sizeritem">
                                      <option>0</option>
                                      <flag>wxALIGN_CENTER_VERTICAL</flag>
                                      <border>0</border>
                                      <object class="wxStaticText" name="i18n_control_12">
                                        <label>Title</label>
                                        <fg>#243042</fg>
                                      </object>
                                    </object>
                                    <object class="sizeritem">
                                      <option>0</option>
                                      <flag>wxEXPAND|wxALIGN_CENTER_VERTICAL</flag>
                                      <border>0</border>
                                      <object class="wxTextCtrl" name="pdf_export_title">
                                        <size>260,28</size>
                                      </object>
                                    </object>
                                    <object class="sizeritem">
                                      <option>0</option>
                                      <flag>wxALIGN_CENTER_VERTICAL</flag>
                                      <border>0</border>
                                      <object class="wxStaticText" name="i18n_control_13">
                                        <label>Author</label>
                                        <fg>#243042</fg>
                                      </object>
                                    </object>
                                    <object class="sizeritem">
                                      <option>0</option>
                                      <flag>wxEXPAND|wxALIGN_CENTER_VERTICAL</flag>
                                      <border>0</border>
                                      <object class="wxTextCtrl" name="pdf_export_author">
                                        <size>260,28</size>
                                      </object>
                                    </object>
                                    <object class="sizeritem">
                                      <option>0</option>
                                      <flag>wxALIGN_CENTER_VERTICAL</flag>
                                      <border>0</border>
                                      <object class="wxStaticText" name="i18n_control_14">
                                        <label>Subject</label>
                                        <fg>#243042</fg>
                                      </object>
                                    </object>
                                    <object class="sizeritem">
                                      <option>0</option>
                                      <flag>wxEXPAND|wxALIGN_CENTER_VERTICAL</flag>
                                      <border>0</border>
                                      <object class="wxTextCtrl" name="pdf_export_subject">
                                        <size>260,28</size>
                                      </object>
                                    </object>
                                    <object class="sizeritem">
                                      <option>0</option>
                                      <flag>wxALIGN_CENTER_VERTICAL</flag>
                                      <border>0</border>
                                      <object class="wxStaticText" name="i18n_control_15">
                                        <label>Keywords</label>
                                        <fg>#243042</fg>
                                      </object>
                                    </object>
                                    <object class="sizeritem">
                                      <option>0</option>
                                      <flag>wxEXPAND|wxALIGN_CENTER_VERTICAL</flag>
                                      <border>0</border>
                                      <object class="wxTextCtrl" name="pdf_export_keywords">
                                        <size>260,28</size>
                                      </object>
                                    </object>
                                  </object>
                                </object>
                              </object>
                            </object>
                          </object>
                        </object>
                        <object class="sizeritem">
                          <option>0</option>
                          <flag>wxEXPAND|wxTOP</flag>
                          <border>24</border>
                          <object class="wxBoxSizer">
                            <orient>wxHORIZONTAL</orient>
                            <object class="sizeritem">
                              <option>0</option>
                              <flag>wxALIGN_CENTER_VERTICAL|wxRIGHT</flag>
                              <border>10</border>
                              <object class="wxStaticText" name="i18n_control_16">
                                <label>Options</label>
                                <fg>#1d3d78</fg>
                                <font>
                                  <weight>bold</weight>
                                </font>
                              </object>
                            </object>
                            <object class="sizeritem">
                              <option>1</option>
                              <flag>wxALIGN_CENTER_VERTICAL</flag>
                              <border>0</border>
                              <object class="wxPanel">
                                <size>-1,1</size>
                                <bg>#dfe4ec</bg>
                              </object>
                            </object>
                          </object>
                        </object>
                        <object class="sizeritem">
                          <option>0</option>
                          <flag>wxEXPAND|wxTOP</flag>
                          <border>10</border>
                          <object class="wxBoxSizer">
                            <orient>wxHORIZONTAL</orient>
                            <object class="spacer">
                              <size>12,1</size>
                              <option>0</option>
                            </object>
                            <object class="sizeritem">
                              <option>1</option>
                              <flag>wxEXPAND</flag>
                              <border>0</border>
                              <object class="wxBoxSizer">
                                <orient>wxVERTICAL</orient>
                                <object class="sizeritem">
                                  <option>0</option>
                                  <flag>wxBOTTOM</flag>
                                  <border>6</border>
                                  <object class="wxCheckBox" name="pdf_export_links">
                                    <label>Keep links and cross-references clickable</label>
                                  </object>
                                </object>
                                <object class="sizeritem">
                                  <option>0</option>
                                  <flag>wxEXPAND</flag>
                                  <border>0</border>
                                  <object class="wxCheckBox" name="pdf_export_open">
                                    <label>Open the PDF when the export finishes</label>
                                  </object>
                                </object>
                              </object>
                            </object>
                          </object>
                        </object>
                      </object>
                    </object>
                  </object>
                </object>
              </object>
            </object>
          </object>
        </object>
      </object>
      <object class="sizeritem">
        <option>0</option>
        <flag>wxEXPAND|wxALL</flag>
        <border>12</border>
        <object class="wxBoxSizer">
          <orient>wxHORIZONTAL</orient>
          <object class="spacer">
            <size>1,1</size>
            <option>1</option>
          </object>
          <object class="sizeritem">
            <option>0</option>
            <flag>wxALIGN_CENTER_VERTICAL</flag>
            <border>0</border>
            <object class="wxButton" name="pdf_export_ok">
              <label>Export</label>
              <size>88,28</size>
              <style>wxBU_EXACTFIT|wxBU_NOTEXT|wxBORDER_NONE</style>
              <default>1</default>
            </object>
          </object>
          <object class="sizeritem">
            <option>0</option>
            <flag>wxALIGN_CENTER_VERTICAL|wxLEFT</flag>
            <border>8</border>
            <object class="wxButton" name="pdf_export_cancel">
              <label>Cancel</label>
              <size>88,28</size>
              <style>wxBU_EXACTFIT|wxBU_NOTEXT|wxBORDER_NONE</style>
            </object>
          </object>
        </object>
      </object>
    </object>
  </object>
</resource>