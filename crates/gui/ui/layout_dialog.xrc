          <object class="sizeritem">
            <option>0</option>
            <flag>wxALIGN_BOTTOM</flag>
            <border>0</border>
            <object class="wxButton" name="lay_tab_0">
              <label>Position</label>
              <size>88,30</size>
              <style>wxBU_EXACTFIT|wxBU_NOTEXT|wxBORDER_NONE</style>
              <bg>#e8ecf2</bg>
