<?xml version='1.0' encoding='utf-8'?>
<resource>
  <object class="wxDialog" name="frm_dialog">
    <title>Frame</title>
    <style>wxDEFAULT_DIALOG_STYLE</style>
    <bg>#e8ecf2</bg>
    <object class="wxBoxSizer">
      <orient>wxVERTICAL</orient>
      <object class="sizeritem">
        <option>1</option>
        <flag>wxEXPAND|wxLEFT|wxRIGHT|wxTOP</flag>
        <border>12</border>
        <object class="wxPanel" name="frm_card">
          <bg>#ffffff</bg>
          <object class="wxBoxSizer">
            <orient>wxVERTICAL</orient>
            <object class="sizeritem">
              <option>1</option>
              <flag>wxEXPAND|wxALL</flag>
              <border>16</border>
              <object class="wxBoxSizer">
                <orient>wxVERTICAL</orient>
                <object class="sizeritem">
                  <option>0</option>
                  <flag>wxEXPAND</flag>
                  <border>0</border>
                  <object class="wxBoxSizer">
                    <orient>wxHORIZONTAL</orient>
                    <object class="sizeritem">
                      <option>0</option>
                      <flag>wxALIGN_CENTER_VERTICAL|wxRIGHT</flag>
                      <border>10</border>
                      <object class="wxStaticText" name="i18n_control_2">
                        <label>Text wrapping</label>
                        <fg>#1d3d78</fg>
                        <font>
                          <weight>bold</weight>
                        </font>
                      </object>
                    </object>
                    <object class="sizeritem">
                      <option>1</option>
                      <flag>wxALIGN_CENTER_VERTICAL</flag>
                      <border>0</border>
                      <object class="wxPanel">
                        <size>-1,1</size>
                        <bg>#dfe4ec</bg>
                      </object>
                    </object>
                  </object>
                </object>
                <object class="sizeritem">
                  <option>0</option>
                  <flag>wxEXPAND|wxTOP</flag>
                  <border>10</border>
                  <object class="wxBoxSizer">
                    <orient>wxHORIZONTAL</orient>
                    <object class="spacer">
                      <size>12,1</size>
                      <option>0</option>
                    </object>
                    <object class="sizeritem">
                      <option>1</option>
                      <flag>wxEXPAND</flag>
                      <border>0</border>
                      <object class="wxBoxSizer">
                        <orient>wxVERTICAL</orient>
                        <object class="sizeritem">
                          <option>0</option>
                          <flag>wxEXPAND</flag>
                          <border>0</border>
                          <object class="wxPanel" name="frm_wrapping">
                            <bg>#ffffff</bg>
                            <size>220,92</size>
                            <style>wxWANTS_CHARS|wxFULL_REPAINT_ON_RESIZE</style>
                          </object>
                        </object>
                      </object>
                    </object>
                  </object>
                </object>
                <object class="sizeritem">
                  <option>0</option>
                  <flag>wxEXPAND|wxTOP</flag>
                  <border>24</border>
                  <object class="wxBoxSizer">
                    <orient>wxHORIZONTAL</orient>
                    <object class="sizeritem">
                      <option>0</option>
                      <flag>wxALIGN_CENTER_VERTICAL|wxRIGHT</flag>
                      <border>10</border>
                      <object class="wxStaticText" name="i18n_control_3">
                        <label>Size</label>
                        <fg>#1d3d78</fg>
                        <font>
                          <weight>bold</weight>
                        </font>
                      </object>
                    </object>
                    <object class="sizeritem">
                      <option>1</option>
                      <flag>wxALIGN_CENTER_VERTICAL</flag>
                      <border>0</border>
                      <object class="wxPanel">
                        <size>-1,1</size>
                        <bg>#dfe4ec</bg>
                      </object>
                    </object>
                  </object>
                </object>
                <object class="sizeritem">
                  <option>0</option>
                  <flag>wxEXPAND|wxTOP</flag>
                  <border>10</border>
                  <object class="wxBoxSizer">
                    <orient>wxHORIZONTAL</orient>
                    <object class="spacer">
                      <size>12,1</size>
                      <option>0</option>
                    </object>
                    <object class="sizeritem">
                      <option>1</option>
                      <flag>wxEXPAND</flag>
                      <border>0</border>
                      <object class="wxBoxSizer">
                        <orient>wxVERTICAL</orient>
                        <object class="sizeritem">
                          <option>0</option>
                          <flag>wxEXPAND</flag>
                          <border>0</border>
                          <object class="wxFlexGridSizer">
                            <rows>0</rows>
                            <cols>4</cols>
                            <vgap>8</vgap>
                            <hgap>12</hgap>
                            <growablecols />
                            <object class="sizeritem">
                              <option>0</option>
                              <flag>wxALIGN_CENTER_VERTICAL</flag>
                              <border>0</border>
                              <object class="wxStaticText" name="i18n_control_4">
                                <label>Width:</label>
                                <size>124,-1</size>
                                <fg>#243042</fg>
                              </object>
                            </object>
                            <object class="sizeritem">
                              <option>0</option>
                              <flag>wxALIGN_CENTER_VERTICAL</flag>
                              <border>0</border>
                              <object class="wxComboBox" name="frm_width_rule">
                                <size>120,28</size>
                                <style>wxCB_READONLY</style>
                                <content>
                                  <item>Auto</item>
                                  <item>Exactly</item>
                                </content>
                                <selection>0</selection>
                              </object>
                              <minsize>140,-1</minsize>
                            </object>
                            <object class="sizeritem">
                              <option>0</option>
                              <flag>wxALIGN_CENTER_VERTICAL|wxLEFT</flag>
                              <border>24</border>
                              <object class="wxStaticText" name="i18n_control_6">
                                <label>At:</label>
                                <size>86,-1</size>
                                <fg>#243042</fg>
                              </object>
                            </object>
                            <object class="sizeritem">
                              <option>0</option>
                              <flag>wxALIGN_CENTER_VERTICAL</flag>
                              <border>0</border>
                              <object class="wxBoxSizer">
                                <orient>wxHORIZONTAL</orient>
                                <object class="sizeritem">
                                  <option>0</option>
                                  <flag>wxALIGN_CENTER_VERTICAL</flag>
                                  <border>0</border>
                                  <object class="wxSpinCtrlDouble" name="frm_width_at">
                                    <size>90,28</size>
                                    <min>0</min>
                                    <max>558</max>
                                    <inc>0.5</inc>
                                    <digits>1</digits>
                                    <value>0</value>
                                  </object>
                                </object>
                                <object class="sizeritem">
                                  <option>0</option>
                                  <flag>wxALIGN_CENTER_VERTICAL|wxLEFT</flag>
                                  <border>6</border>
                                  <object class="wxStaticText" name="i18n_control_7">
                                    <label>mm</label>
                                    <fg>#6b778a</fg>
                                  </object>
                                </object>
                              </object>
                            </object>
                            <object class="sizeritem">
                              <option>0</option>
                              <flag>wxALIGN_CENTER_VERTICAL</flag>
                              <border>0</border>
                              <object class="wxStaticText" name="i18n_control_8">
                                <label>Height:</label>
                                <size>124,-1</size>
                                <fg>#243042</fg>
                              </object>
                            </object>
                            <object class="sizeritem">
                              <option>0</option>
                              <flag>wxALIGN_CENTER_VERTICAL</flag>
                              <border>0</border>
                              <object class="wxComboBox" name="frm_height_rule">
                                <size>120,28</size>
                                <style>wxCB_READONLY</style>
                                <content>
                                  <item>Auto</item>
                                  <item>At least</item>
                                  <item>Exactly</item>
                                </content>
                                <selection>0</selection>
                              </object>
                              <minsize>140,-1</minsize>
                            </object>
                            <object class="sizeritem">
                              <option>0</option>
                              <flag>wxALIGN_CENTER_VERTICAL|wxLEFT</flag>
                              <border>24</border>
                              <object class="wxStaticText" name="i18n_control_10">
                                <label>At:</label>
                                <size>86,-1</size>
                                <fg>#243042</fg>
                              </object>
                            </object>
                            <object class="sizeritem">
                              <option>0</option>
                              <flag>wxALIGN_CENTER_VERTICAL</flag>
                              <border>0</border>
                              <object class="wxBoxSizer">
                                <orient>wxHORIZONTAL</orient>
                                <object class="sizeritem">
                                  <option>0</option>
                                  <flag>wxALIGN_CENTER_VERTICAL</flag>
                                  <border>0</border>
                                  <object class="wxSpinCtrlDouble" name="frm_height_at">
                                    <size>90,28</size>
                                    <min>0</min>
                                    <max>558</max>
                                    <inc>0.5</inc>
                                    <digits>1</digits>
                                    <value>0</value>
                                  </object>
                                </object>
                                <object class="sizeritem">
                                  <option>0</option>
                                  <flag>wxALIGN_CENTER_VERTICAL|wxLEFT</flag>
                                  <border>6</border>
                                  <object class="wxStaticText" name="i18n_control_11">
                                    <label>mm</label>
                                    <fg>#6b778a</fg>
                                  </object>
                                </object>
                              </object>
                            </object>
                          </object>
                        </object>
                      </object>
                    </object>
                  </object>
                </object>
                <object class="sizeritem">
                  <option>0</option>
                  <flag>wxEXPAND|wxTOP</flag>
                  <border>24</border>
                  <object class="wxBoxSizer">
                    <orient>wxHORIZONTAL</orient>
                    <object class="sizeritem">
                      <option>0</option>
                      <flag>wxALIGN_CENTER_VERTICAL|wxRIGHT</flag>
                      <border>10</border>
                      <object class="wxStaticText" name="i18n_control_12">
                        <label>Horizontal</label>
                        <fg>#1d3d78</fg>
                        <font>
                          <weight>bold</weight>
                        </font>
                      </object>
                    </object>
                    <object class="sizeritem">
                      <option>1</option>
                      <flag>wxALIGN_CENTER_VERTICAL</flag>
                      <border>0</border>
                      <object class="wxPanel">
                        <size>-1,1</size>
                        <bg>#dfe4ec</bg>
                      </object>
                    </object>
                  </object>
                </object>
                <object class="sizeritem">
                  <option>0</option>
                  <flag>wxEXPAND|wxTOP</flag>
                  <border>10</border>
                  <object class="wxBoxSizer">
                    <orient>wxHORIZONTAL</orient>
                    <object class="spacer">
                      <size>12,1</size>
                      <option>0</option>
                    </object>
                    <object class="sizeritem">
                      <option>1</option>
                      <flag>wxEXPAND</flag>
                      <border>0</border>
                      <object class="wxBoxSizer">
                        <orient>wxVERTICAL</orient>
                        <object class="sizeritem">
                          <option>0</option>
                          <flag>wxEXPAND</flag>
                          <border>0</border>
                          <object class="wxFlexGridSizer">
                            <rows>0</rows>
                            <cols>4</cols>
                            <vgap>8</vgap>
                            <hgap>12</hgap>
                            <growablecols />
                            <object class="sizeritem">
                              <option>0</option>
                              <flag>wxALIGN_CENTER_VERTICAL</flag>
                              <border>0</border>
                              <object class="wxStaticText" name="i18n_control_13">
                                <label>Position:</label>
                                <size>124,-1</size>
                                <fg>#243042</fg>
                              </object>
                            </object>
                            <object class="sizeritem">
                              <option>0</option>
                              <flag>wxALIGN_CENTER_VERTICAL</flag>
                              <border>0</border>
                              <object class="wxComboBox" name="frm_h_position">
                                <size>120,28</size>
                                <content>
                                  <item>Left</item>
                                  <item>Right</item>
                                  <item>Center</item>
                                  <item>Inside</item>
                                  <item>Outside</item>
                                </content>
                              </object>
                              <minsize>140,-1</minsize>
                            </object>
                            <object class="sizeritem">
                              <option>0</option>
                              <flag>wxALIGN_CENTER_VERTICAL|wxLEFT</flag>
                              <border>24</border>
                              <object class="wxStaticText" name="i18n_control_15">
                                <label>Relative to:</label>
                                <size>86,-1</size>
                                <fg>#243042</fg>
                              </object>
                            </object>
                            <object class="sizeritem">
                              <option>0</option>
                              <flag>wxALIGN_CENTER_VERTICAL</flag>
                              <border>0</border>
                              <object class="wxComboBox" name="frm_h_relative">
                                <size>120,28</size>
                                <style>wxCB_READONLY</style>
                                <content>
                                  <item>Column</item>
                                  <item>Margin</item>
                                  <item>Page</item>
                                </content>
                                <selection>0</selection>
                              </object>
                            </object>
                            <object class="sizeritem">
                              <option>0</option>
                              <flag>wxALIGN_CENTER_VERTICAL</flag>
                              <border>0</border>
                              <object class="wxStaticText" name="i18n_control_17">
                                <label>Distance from text:</label>
                                <size>124,-1</size>
                                <fg>#243042</fg>
                              </object>
                            </object>
                            <object class="sizeritem">
                              <option>0</option>
                              <flag>wxALIGN_CENTER_VERTICAL</flag>
                              <border>0</border>
                              <object class="wxBoxSizer">
                                <orient>wxHORIZONTAL</orient>
                                <object class="sizeritem">
                                  <option>0</option>
                                  <flag>wxALIGN_CENTER_VERTICAL</flag>
                                  <border>0</border>
                                  <object class="wxSpinCtrlDouble" name="frm_h_distance">
                                    <size>90,28</size>
                                    <min>0</min>
                                    <max>558</max>
                                    <inc>0.5</inc>
                                    <digits>1</digits>
                                    <value>0</value>
                                  </object>
                                </object>
                                <object class="sizeritem">
                                  <option>0</option>
                                  <flag>wxALIGN_CENTER_VERTICAL|wxLEFT</flag>
                                  <border>6</border>
                                  <object class="wxStaticText" name="i18n_control_18">
                                    <label>mm</label>
                                    <fg>#6b778a</fg>
                                  </object>
                                </object>
                              </object>
                              <minsize>140,-1</minsize>
                            </object>
                          </object>
                        </object>
                      </object>
                    </object>
                  </object>
                </object>
                <object class="sizeritem">
                  <option>0</option>
                  <flag>wxEXPAND|wxTOP</flag>
                  <border>24</border>
                  <object class="wxBoxSizer">
                    <orient>wxHORIZONTAL</orient>
                    <object class="sizeritem">
                      <option>0</option>
                      <flag>wxALIGN_CENTER_VERTICAL|wxRIGHT</flag>
                      <border>10</border>
