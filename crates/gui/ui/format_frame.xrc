                        <label>Vertical</label>
                        <fg>#1d3d78</fg>
                        <font>
                          <weight>bold</weight>
                        </font>
                      </object>
                    </object>
                    <object class="sizeritem">
                      <option>1</option>
                      <flag>wxALIGN_CENTER_VERTICAL</flag>
                      <border>0</border>
                      <object class="wxPanel">
                        <size>-1,1</size>
                        <bg>#dfe4ec</bg>
                      </object>
                    </object>
                  </object>
                </object>
                <object class="sizeritem">
                  <option>0</option>
                  <flag>wxEXPAND|wxTOP</flag>
                  <border>10</border>
                  <object class="wxBoxSizer">
                    <orient>wxHORIZONTAL</orient>
                    <object class="spacer">
                      <size>12,1</size>
                      <option>0</option>
                    </object>
                    <object class="sizeritem">
                      <option>1</option>
                      <flag>wxEXPAND</flag>
                      <border>0</border>
                      <object class="wxBoxSizer">
                        <orient>wxVERTICAL</orient>
                        <object class="sizeritem">
                          <option>0</option>
                          <flag>wxEXPAND</flag>
                          <border>0</border>
                          <object class="wxFlexGridSizer">
                            <rows>0</rows>
                            <cols>4</cols>
                            <vgap>8</vgap>
                            <hgap>12</hgap>
