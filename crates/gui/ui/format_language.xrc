<?xml version='1.0' encoding='utf-8'?>
<resource>
  <object class="wxDialog" name="lng_dialog">
    <title>Language</title>
    <style>wxDEFAULT_DIALOG_STYLE</style>
    <bg>#e8ecf2</bg>
    <object class="wxBoxSizer">
      <orient>wxVERTICAL</orient>
      <object class="sizeritem">
        <option>1</option>
        <flag>wxEXPAND|wxLEFT|wxRIGHT|wxTOP</flag>
        <border>12</border>
        <object class="wxPanel" name="lng_card">
          <bg>#ffffff</bg>
          <object class="wxBoxSizer">
            <orient>wxVERTICAL</orient>
            <object class="sizeritem">
              <option>1</option>
              <flag>wxEXPAND|wxALL</flag>
              <border>16</border>
              <object class="wxBoxSizer">
                <orient>wxVERTICAL</orient>
                <object class="sizeritem">
                  <option>0</option>
                  <flag>wxEXPAND</flag>
                  <border>0</border>
                  <object class="wxBoxSizer">
                    <orient>wxHORIZONTAL</orient>
                    <object class="sizeritem">
                      <option>0</option>
                      <flag>wxALIGN_CENTER_VERTICAL|wxRIGHT</flag>
                      <border>10</border>
                      <object class="wxStaticText" name="i18n_control_2">
                        <label>Mark selected text as</label>
                        <fg>#1d3d78</fg>
                        <font>
                          <weight>bold</weight>
                        </font>
                      </object>
                    </object>
                    <object class="sizeritem">
                      <option>1</option>
                      <flag>wxALIGN_CENTER_VERTICAL</flag>
                      <border>0</border>
                      <object class="wxPanel">
                        <size>-1,1</size>
                        <bg>#dfe4ec</bg>
                      </object>
                    </object>
                  </object>
                </object>
                <object class="sizeritem">
                  <option>1</option>
                  <flag>wxEXPAND|wxTOP</flag>
                  <border>10</border>
                  <object class="wxBoxSizer">
                    <orient>wxHORIZONTAL</orient>
                    <object class="spacer">
                      <size>12,1</size>
                      <option>0</option>
                    </object>
                    <object class="sizeritem">
                      <option>1</option>
                      <flag>wxEXPAND</flag>
                      <border>0</border>
                      <object class="wxBoxSizer">
                        <orient>wxVERTICAL</orient>
                        <object class="sizeritem">
                          <option>1</option>
                          <flag>wxEXPAND</flag>
                          <border>0</border>
                          <object class="wxListBox" name="lng_list">
                            <size>380,210</size>
                            <style>wxLB_SINGLE</style>
                          </object>
                        </object>
                        <object class="sizeritem">
                          <option>0</option>
                          <flag>wxEXPAND|wxTOP</flag>
                          <border>12</border>
                          <object class="wxFlexGridSizer">
                            <rows>0</rows>
                            <cols>2</cols>
                            <vgap>8</vgap>
                            <hgap>12</hgap>
                            <growablecols>1</growablecols>
                            <object class="sizeritem">
                              <option>0</option>
                              <flag>wxALIGN_CENTER_VERTICAL</flag>
                              <border>0</border>
                              <object class="wxStaticText" name="i18n_control_3">
                                <label>Language tag:</label>
                                <fg>#243042</fg>
                              </object>
                            </object>
                            <object class="sizeritem">
                              <option>0</option>
                              <flag>wxALIGN_CENTER_VERTICAL</flag>
                              <border>0</border>
                              <object class="wxTextCtrl" name="lng_tag">
                                <size>160,28</size>
                                <tooltip>BCP 47 tag, for example en-US or pt-BR</tooltip>
                              </object>
                            </object>
                          </object>
                        </object>
                        <object class="sizeritem">
                          <option>0</option>
                          <flag>wxEXPAND|wxTOP</flag>
                          <border>8</border>
                          <object class="wxStaticText" name="lng_note">
                            <label>The speller and other proofing tools automatically use dictionaries of the selected language, if available.</label>
                            <wrap>380</wrap>
                            <fg>#6b778a</fg>
                          </object>
                        </object>
                      </object>
                    </object>
                  </object>
                </object>
                <object class="sizeritem">
                  <option>0</option>
                  <flag>wxEXPAND|wxTOP</flag>
                  <border>24</border>
                  <object class="wxBoxSizer">
                    <orient>wxHORIZONTAL</orient>
                    <object class="sizeritem">
                      <option>0</option>
                      <flag>wxALIGN_CENTER_VERTICAL|wxRIGHT</flag>
                      <border>10</border>
                      <object class="wxStaticText" name="i18n_control_6">
                        <label>Proofing</label>
                        <fg>#1d3d78</fg>
                        <font>
                          <weight>bold</weight>
                        </font>
                      </object>
                    </object>
                    <object class="sizeritem">
                      <option>1</option>
                      <flag>wxALIGN_CENTER_VERTICAL</flag>
                      <border>0</border>
                      <object class="wxPanel">
                        <size>-1,1</size>
                        <bg>#dfe4ec</bg>
                      </object>
                    </object>
                  </object>
                </object>
                <object class="sizeritem">
                  <option>0</option>
                  <flag>wxEXPAND|wxTOP</flag>
                  <border>10</border>
                  <object class="wxBoxSizer">
                    <orient>wxHORIZONTAL</orient>
                    <object class="spacer">
                      <size>12,1</size>
                      <option>0</option>
                    </object>
                    <object class="sizeritem">
                      <option>1</option>
                      <flag>wxEXPAND</flag>
                      <border>0</border>
                      <object class="wxBoxSizer">
                        <orient>wxVERTICAL</orient>
                        <object class="sizeritem">
                          <option>0</option>
                          <flag>wxEXPAND</flag>
                          <border>0</border>
                          <object class="wxFlexGridSizer">
                            <rows>0</rows>
                            <cols>1</cols>
                            <vgap>8</vgap>
                            <hgap>32</hgap>
                            <growablecols />
                            <object class="sizeritem">
                              <option>0</option>
                              <flag>wxALIGN_CENTER_VERTICAL</flag>
                              <border>0</border>
                              <object class="wxCheckBox" name="lng_no_proof">
                                <label>Do not check spelling or grammar</label>
                              </object>
                            </object>
                            <object class="sizeritem">
                              <option>0</option>
                              <flag>wxALIGN_CENTER_VERTICAL</flag>
                              <border>0</border>
                              <object class="wxCheckBox" name="lng_detect">
                                <label>Detect language automatically</label>
                              </object>
                            </object>
                          </object>
                        </object>
                      </object>
                    </object>
                  </object>
                </object>
              </object>
            </object>
          </object>
        </object>
      </object>
      <object class="sizeritem">
        <option>0</option>
        <flag>wxEXPAND|wxLEFT|wxRIGHT|wxTOP</flag>
        <border>12</border>
        <object class="wxStaticLine" />
      </object>
      <object class="sizeritem">
        <option>0</option>
        <flag>wxEXPAND|wxALL</flag>
        <border>12</border>
        <object class="wxBoxSizer">
          <orient>wxHORIZONTAL</orient>
          <object class="sizeritem">
            <option>0</option>
            <flag>wxALIGN_CENTER_VERTICAL</flag>
            <border>0</border>
            <object class="wxButton" name="lng_default">
              <label>Set As Default</label>
            </object>
            <minsize>110,-1</minsize>
          </object>
          <object class="spacer">
            <size>1,1</size>
            <option>1</option>
          </object>
          <object class="sizeritem">
            <option>0</option>
            <flag>wxALIGN_CENTER_VERTICAL</flag>
            <border>0</border>
            <object class="wxGridBagSizer">
              <hgap>12</hgap>
              <object class="sizeritem">
                <option>0</option>
                <flag>wxALIGN_CENTER_VERTICAL</flag>
                <border>0</border>
                <object class="wxButton" name="lng_cancel">
                  <label>Cancel</label>
                </object>
                <minsize>96,-1</minsize>
                <cellpos platform="unix|mac">0,0</cellpos>
                <cellpos platform="msw">0,1</cellpos>
              </object>
              <object class="sizeritem">
                <option>0</option>
                <flag>wxALIGN_CENTER_VERTICAL</flag>
                <border>0</border>
                <object class="wxButton" name="lng_ok">
                  <label>OK</label>
                  <default>1</default>
                </object>
                <minsize>96,-1</minsize>
                <cellpos platform="unix|mac">0,1</cellpos>
                <cellpos platform="msw">0,0</cellpos>
              </object>
            </object>
          </object>
        </object>
      </object>
    </object>
  </object>
</resource>