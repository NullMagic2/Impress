<?xml version='1.0' encoding='utf-8'?>
<resource>
  <object class="wxDialog" name="rec_dialog">
    <title>Recover Documents</title>
    <style>wxDEFAULT_DIALOG_STYLE</style>
    <bg>#e8ecf2</bg>
    <object class="wxBoxSizer">
      <orient>wxVERTICAL</orient>
      <object class="sizeritem">
        <option>1</option>
        <flag>wxEXPAND|wxLEFT|wxRIGHT|wxTOP</flag>
        <border>12</border>
        <object class="wxPanel" name="rec_card">
          <bg>#ffffff</bg>
          <object class="wxBoxSizer">
            <orient>wxVERTICAL</orient>
            <object class="sizeritem">
              <option>1</option>
              <flag>wxEXPAND|wxALL</flag>
              <border>16</border>
              <object class="wxBoxSizer">
                <orient>wxVERTICAL</orient>
                <object class="sizeritem">
                  <option>0</option>
                  <flag>wxBOTTOM</flag>
                  <border>4</border>
                  <object class="wxStaticText" name="rec_heading">
                    <label>Impress kept copies of documents that were not saved.</label>
                    <fg>#243042</fg>
                    <font>
                      <weight>bold</weight>
                    </font>
                  </object>
                </object>
                <object class="sizeritem">
                  <option>0</option>
                  <flag>wxBOTTOM</flag>
                  <border>14</border>
                  <object class="wxStaticText" name="rec_hint">
                    <label>Choose one to restore. It opens as a new, unsaved document and never replaces the original file.</label>
                    <fg>#6b778a</fg>
                  </object>
                </object>
                <object class="sizeritem">
                  <option>1</option>
                  <flag>wxEXPAND</flag>
                  <border>0</border>
                  <object class="wxBoxSizer">
                    <orient>wxHORIZONTAL</orient>
                    <object class="sizeritem">
                      <option>1</option>
                      <flag>wxEXPAND|wxRIGHT</flag>
                      <border>16</border>
                      <object class="wxPanel" name="rec_list">
                        <bg>#ffffff</bg>
                        <size>330,300</size>
                        <style>wxWANTS_CHARS|wxFULL_REPAINT_ON_RESIZE</style>
                      </object>
                    </object>
                    <object class="sizeritem">
                      <option>0</option>
                      <flag>wxEXPAND</flag>
                      <border>0</border>
                      <object class="wxBoxSizer">
                        <orient>wxVERTICAL</orient>
                        <object class="sizeritem">
                          <option>0</option>
                          <flag>wxBOTTOM</flag>
                          <border>6</border>
                          <object class="wxStaticText" name="rec_preview_caption">
                            <label>Preview</label>
                            <fg>#6b778a</fg>
                          </object>
                        </object>
                        <object class="sizeritem">
                          <option>1</option>
                          <flag>wxEXPAND</flag>
                          <border>0</border>
                          <object class="wxPanel" name="rec_preview">
                            <bg>#eef2f7</bg>
                            <size>230,280</size>
                            <style>wxWANTS_CHARS|wxFULL_REPAINT_ON_RESIZE</style>
                          </object>
                        </object>
                      </object>
                    </object>
                  </object>
                </object>
              </object>
            </object>
          </object>
        </object>
      </object>
      <object class="sizeritem">
        <option>0</option>
        <flag>wxEXPAND|wxALL</flag>
        <border>12</border>
        <object class="wxBoxSizer">
          <orient>wxHORIZONTAL</orient>
          <object class="sizeritem">
            <option>0</option>
            <flag>wxALIGN_CENTER_VERTICAL</flag>
            <border>0</border>
            <object class="wxButton" name="rec_delete">
              <label>Delete</label>
              <size>96,28</size>
              <style>wxBU_EXACTFIT|wxBU_NOTEXT|wxBORDER_NONE</style>
            </object>
          </object>
          <object class="spacer">
            <size>1,1</size>
            <option>1</option>
          </object>
          <object class="sizeritem">
            <option>0</option>
            <flag>wxALIGN_CENTER_VERTICAL</flag>
            <border>0</border>
            <object class="wxButton" name="rec_ok">
              <label>Restore</label>
              <size>88,28</size>
              <style>wxBU_EXACTFIT|wxBU_NOTEXT|wxBORDER_NONE</style>
              <default>1</default>
            </object>
          </object>
          <object class="sizeritem">
            <option>0</option>
            <flag>wxALIGN_CENTER_VERTICAL|wxLEFT</flag>
            <border>8</border>
            <object class="wxButton" name="rec_cancel">
              <label>Cancel</label>
              <size>88,28</size>
              <style>wxBU_EXACTFIT|wxBU_NOTEXT|wxBORDER_NONE</style>
            </object>
          </object>
        </object>
      </object>
    </object>
  </object>
</resource>