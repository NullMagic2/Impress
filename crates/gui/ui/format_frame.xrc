                                <content>
                                  <item>Top</item>
                                  <item>Bottom</item>
                                  <item>Center</item>
                                  <item>Inside</item>
                                  <item>Outside</item>
                                </content>
                              </object>
                              <minsize>140,-1</minsize>
                            </object>
                            <object class="sizeritem">
                              <option>0</option>
                              <flag>wxALIGN_CENTER_VERTICAL|wxLEFT</flag>
                              <border>24</border>
                              <object class="wxStaticText" name="i18n_control_22">
                                <label>Relative to:</label>
                                <size>86,-1</size>
                                <fg>#243042</fg>
                              </object>
                            </object>
                            <object class="sizeritem">
                              <option>0</option>
                              <flag>wxALIGN_CENTER_VERTICAL</flag>
                              <border>0</border>
                              <object class="wxComboBox" name="frm_v_relative">
                                <size>120,28</size>
                                <style>wxCB_READONLY</style>
                                <content>
                                  <item>Margin</item>
                                  <item>Page</item>
                                  <item>Paragraph</item>
                                </content>
                                <selection>0</selection>
                              </object>
                            </object>
                            <object class="sizeritem">
                              <option>0</option>
                              <flag>wxALIGN_CENTER_VERTICAL</flag>
                              <border>0</border>
                              <object class="wxStaticText" name="i18n_control_24">
                                <label>Distance from text:</label>
                                <size>124,-1</size>
                                <fg>#243042</fg>
                              </object>
                            </object>
                            <object class="sizeritem">
                              <option>0</option>
                              <flag>wxALIGN_CENTER_VERTICAL</flag>
                              <border>0</border>
                              <object class="wxBoxSizer">
                                <orient>wxHORIZONTAL</orient>
                                <object class="sizeritem">
                                  <option>0</option>
                                  <flag>wxALIGN_CENTER_VERTICAL</flag>
                                  <border>0</border>
                                  <object class="wxSpinCtrlDouble" name="frm_v_distance">
                                    <size>90,28</size>
                                    <min>0</min>
                                    <max>558</max>
                                    <inc>0.5</inc>
                                    <digits>1</digits>
