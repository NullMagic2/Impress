                                  <object class="sizeritem">
                                    <option>0</option>
                                    <flag>wxALIGN_CENTER_VERTICAL|wxLEFT</flag>
                                    <border>24</border>
                                    <object class="wxStaticText" name="i18n_control_19">
                                      <label>By:</label>
                                      <size>96,-1</size>
                                      <fg>#243042</fg>
                                    </object>
                                  </object>
                                  <object class="sizeritem">
                                    <option>0</option>
                                    <flag>wxALIGN_CENTER_VERTICAL</flag>
