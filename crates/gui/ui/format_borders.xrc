                                    <option>1</option>
                                    <flag>wxEXPAND</flag>
                                    <border>0</border>
                                    <object class="wxBoxSizer">
                                      <orient>wxVERTICAL</orient>
                                      <object class="sizeritem">
                                        <option>1</option>
                                        <flag>wxEXPAND</flag>
                                        <border>0</border>
                                        <object class="wxPanel" name="bdr_setting">
                                          <bg>#ffffff</bg>
                                          <size>120,254</size>
                                          <style>wxWANTS_CHARS|wxFULL_REPAINT_ON_RESIZE</style>
                                        </object>
                                      </object>
                                    </object>
                                  </object>
                                </object>
                              </object>
                            </object>
                          </object>
                          <object class="sizeritem">
                            <option>0</option>
                            <flag>wxEXPAND|wxLEFT</flag>
                            <border>24</border>
                            <object class="wxBoxSizer">
                              <orient>wxVERTICAL</orient>
                              <object class="sizeritem">
                                <option>0</option>
                                <flag>wxEXPAND</flag>
                                <border>0</border>
                                <object class="wxBoxSizer">
                                  <orient>wxHORIZONTAL</orient>
                                  <object class="sizeritem">
                                    <option>0</option>
                                    <flag>wxALIGN_CENTER_VERTICAL|wxRIGHT</flag>
                                    <border>10</border>
                                    <object class="wxStaticText" name="i18n_control_5">
                                      <label>Style</label>
                                      <fg>#1d3d78</fg>
                                      <font>
                                        <weight>bold</weight>
                                      </font>
                                    </object>
                                  </object>
                                  <object class="sizeritem">
                                    <option>1</option>
                                    <flag>wxALIGN_CENTER_VERTICAL</flag>
                                    <border>0</border>
                                    <object class="wxPanel">
                                      <size>-1,1</size>
                                      <bg>#dfe4ec</bg>
                                    </object>
                                  </object>
                                </object>
                              </object>
                              <object class="sizeritem">
                                <option>1</option>
                                <flag>wxEXPAND|wxTOP</flag>
                                <border>10</border>
                                <object class="wxBoxSizer">
                                  <orient>wxHORIZONTAL</orient>
                                  <object class="spacer">
                                    <size>12,1</size>
                                    <option>0</option>
                                  </object>
                                  <object class="sizeritem">
                                    <option>1</option>
                                    <flag>wxEXPAND</flag>
                                    <border>0</border>
                                    <object class="wxBoxSizer">
                                      <orient>wxVERTICAL</orient>
                                      <object class="sizeritem">
                                        <option>1</option>
                                        <flag>wxEXPAND</flag>
                                        <border>0</border>
                                        <object class="wxPanel" name="bdr_style_list">
                                          <bg>#ffffff</bg>
                                          <size>170,196</size>
                                          <style>wxWANTS_CHARS|wxFULL_REPAINT_ON_RESIZE</style>
                                        </object>
                                      </object>
                                      <object class="sizeritem">
                                        <option>0</option>
                                        <flag>wxEXPAND|wxTOP</flag>
                                        <border>12</border>
