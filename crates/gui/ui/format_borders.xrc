<?xml version='1.0' encoding='utf-8'?>
<resource>
  <object class="wxDialog" name="bdr_dialog">
    <title>Borders and Shading</title>
    <style>wxDEFAULT_DIALOG_STYLE</style>
    <bg>#e8ecf2</bg>
    <object class="wxBoxSizer">
      <orient>wxVERTICAL</orient>
      <object class="sizeritem">
        <option>0</option>
        <flag>wxLEFT|wxRIGHT|wxTOP</flag>
        <border>12</border>
        <object class="wxBoxSizer">
          <orient>wxHORIZONTAL</orient>
          <object class="spacer">
            <size>8,1</size>
            <option>0</option>
          </object>
          <object class="sizeritem">
            <option>0</option>
            <flag>wxALIGN_BOTTOM</flag>
            <border>0</border>
            <object class="wxButton" name="bdr_tab_0">
              <label>Borders</label>
              <size>88,30</size>
              <style>wxBU_EXACTFIT|wxBORDER_NONE</style>
              <bg>#e8ecf2</bg>
            </object>
          </object>
          <object class="sizeritem">
            <option>0</option>
            <flag>wxALIGN_BOTTOM</flag>
            <border>0</border>
            <object class="wxButton" name="bdr_tab_1">
              <label>Shading</label>
              <size>88,30</size>
              <style>wxBU_EXACTFIT|wxBORDER_NONE</style>
              <bg>#e8ecf2</bg>
            </object>
          </object>
        </object>
      </object>
      <object class="sizeritem">
        <option>1</option>
        <flag>wxEXPAND|wxLEFT|wxRIGHT</flag>
        <border>12</border>
        <object class="wxPanel" name="bdr_card">
          <bg>#ffffff</bg>
          <object class="wxBoxSizer">
            <orient>wxVERTICAL</orient>
            <object class="sizeritem">
              <option>1</option>
              <flag>wxEXPAND|wxALL</flag>
              <border>16</border>
              <object class="wxBoxSizer">
                <orient>wxVERTICAL</orient>
                <object class="sizeritem">
                  <option>1</option>
                  <flag>wxEXPAND</flag>
                  <border>0</border>
                  <object class="wxPanel" name="bdr_page_0">
                    <bg>#ffffff</bg>
                    <object class="wxBoxSizer">
                      <orient>wxVERTICAL</orient>
                      <object class="sizeritem">
                        <option>1</option>
                        <flag>wxEXPAND</flag>
                        <border>0</border>
                        <object class="wxBoxSizer">
                          <orient>wxHORIZONTAL</orient>
                          <object class="sizeritem">
                            <option>0</option>
                            <flag>wxEXPAND</flag>
                            <border>0</border>
                            <object class="wxBoxSizer">
                              <orient>wxVERTICAL</orient>
                              <object class="sizeritem">
                                <option>0</option>
                                <flag>wxEXPAND</flag>
                                <border>0</border>
                                <object class="wxBoxSizer">
                                  <orient>wxHORIZONTAL</orient>
                                  <object class="sizeritem">
                                    <option>0</option>
                                    <flag>wxALIGN_CENTER_VERTICAL|wxRIGHT</flag>
                                    <border>10</border>
                                    <object class="wxStaticText" name="i18n_control_4">
                                      <label>Setting</label>
                                      <fg>#1d3d78</fg>
                                      <font>
                                        <weight>bold</weight>
                                      </font>
                                    </object>
                                  </object>
                                  <object class="sizeritem">
                                    <option>1</option>
                                    <flag>wxALIGN_CENTER_VERTICAL</flag>
                                    <border>0</border>
                                    <object class="wxPanel">
                                      <size>-1,1</size>
                                      <bg>#dfe4ec</bg>
                                    </object>
                                  </object>
                                </object>
                              </object>
                              <object class="sizeritem">
                                <option>1</option>
                                <flag>wxEXPAND|wxTOP</flag>
                                <border>10</border>
                                <object class="wxBoxSizer">
                                  <orient>wxHORIZONTAL</orient>
                                  <object class="spacer">
                                    <size>12,1</size>
