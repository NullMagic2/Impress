<?xml version='1.0' encoding='utf-8'?>
<resource>
  <object class="wxDialog" name="par_dialog">
    <title>Paragraph</title>
    <style>wxDEFAULT_DIALOG_STYLE</style>
    <bg>#e8ecf2</bg>
    <object class="wxBoxSizer">
      <orient>wxVERTICAL</orient>
      <object class="sizeritem">
        <option>0</option>
        <flag>wxLEFT|wxRIGHT|wxTOP</flag>
        <border>12</border>
        <object class="wxBoxSizer">
          <orient>wxHORIZONTAL</orient>
          <object class="spacer">
            <size>8,1</size>
            <option>0</option>
          </object>
          <object class="sizeritem">
            <option>0</option>
            <flag>wxALIGN_BOTTOM</flag>
            <border>0</border>
            <object class="wxButton" name="par_tab_0">
              <label>Indents and Spacing</label>
              <size>149,30</size>
              <style>wxBU_EXACTFIT|wxBORDER_NONE</style>
              <bg>#e8ecf2</bg>
            </object>
          </object>
          <object class="sizeritem">
            <option>0</option>
            <flag>wxALIGN_BOTTOM</flag>
            <border>0</border>
            <object class="wxButton" name="par_tab_1">
              <label>Line and Page Breaks</label>
              <size>156,30</size>
              <style>wxBU_EXACTFIT|wxBORDER_NONE</style>
              <bg>#e8ecf2</bg>
            </object>
          </object>
        </object>
      </object>
      <object class="sizeritem">
        <option>1</option>
        <flag>wxEXPAND|wxLEFT|wxRIGHT</flag>
        <border>12</border>
        <object class="wxPanel" name="par_card">
          <bg>#ffffff</bg>
          <object class="wxBoxSizer">
            <orient>wxVERTICAL</orient>
            <object class="sizeritem">
              <option>1</option>
              <flag>wxEXPAND|wxALL</flag>
              <border>16</border>
              <object class="wxBoxSizer">
                <orient>wxVERTICAL</orient>
                <object class="sizeritem">
                  <option>1</option>
                  <flag>wxEXPAND</flag>
                  <border>0</border>
                  <object class="wxPanel" name="par_page_0">
                    <bg>#ffffff</bg>
                    <object class="wxBoxSizer">
                      <orient>wxVERTICAL</orient>
                      <object class="sizeritem">
                        <option>0</option>
                        <flag>wxEXPAND</flag>
                        <border>0</border>
                        <object class="wxBoxSizer">
                          <orient>wxHORIZONTAL</orient>
                          <object class="sizeritem">
                            <option>0</option>
                            <flag>wxALIGN_CENTER_VERTICAL|wxRIGHT</flag>
                            <border>10</border>
                            <object class="wxStaticText" name="i18n_control_4">
                              <label>General</label>
                              <fg>#1d3d78</fg>
                              <font>
                                <weight>bold</weight>
                              </font>
                            </object>
                          </object>
                          <object class="sizeritem">
                            <option>1</option>
                            <flag>wxALIGN_CENTER_VERTICAL</flag>
                            <border>0</border>
                            <object class="wxPanel">
                              <size>-1,1</size>
                              <bg>#dfe4ec</bg>
                            </object>
                          </object>
                        </object>
                      </object>
                      <object class="sizeritem">
                        <option>0</option>
                        <flag>wxEXPAND|wxTOP</flag>
                        <border>10</border>
                        <object class="wxBoxSizer">
                          <orient>wxHORIZONTAL</orient>
                          <object class="spacer">
                            <size>12,1</size>
                            <option>0</option>
                          </object>
                          <object class="sizeritem">
                            <option>1</option>
                            <flag>wxEXPAND</flag>
                            <border>0</border>
                            <object class="wxBoxSizer">
                              <orient>wxVERTICAL</orient>
                              <object class="sizeritem">
                                <option>0</option>
                                <flag>wxEXPAND</flag>
                                <border>0</border>
                                <object class="wxFlexGridSizer">
                                  <rows>0</rows>
                                  <cols>4</cols>
                                  <vgap>8</vgap>
                                  <hgap>12</hgap>
                                  <growablecols />
                                  <object class="sizeritem">
                                    <option>0</option>
                                    <flag>wxALIGN_CENTER_VERTICAL</flag>
                                    <border>0</border>
                                    <object class="wxStaticText" name="i18n_control_5">
                                      <label>Alignment:</label>
                                      <size>86,-1</size>
                                      <fg>#243042</fg>
                                    </object>
                                  </object>
                                  <object class="sizeritem">
                                    <option>0</option>
                                    <flag>wxALIGN_CENTER_VERTICAL</flag>
                                    <border>0</border>
                                    <object class="wxComboBox" name="par_alignment">
                                      <size>150,28</size>
                                      <style>wxCB_READONLY</style>
                                      <content>
                                        <item>Left</item>
                                        <item>Centered</item>
                                        <item>Right</item>
                                        <item>Justified</item>
                                      </content>
                                      <selection>0</selection>
                                    </object>
                                    <minsize>180,-1</minsize>
                                  </object>
                                  <object class="sizeritem">
                                    <option>0</option>
                                    <flag>wxALIGN_CENTER_VERTICAL|wxLEFT</flag>
                                    <border>24</border>
                                    <object class="wxStaticText" name="i18n_control_7">
                                      <label>Outline level:</label>
                                      <size>96,-1</size>
                                      <fg>#243042</fg>
                                    </object>
                                  </object>
                                  <object class="sizeritem">
                                    <option>0</option>
                                    <flag>wxALIGN_CENTER_VERTICAL</flag>
                                    <border>0</border>
                                    <object class="wxComboBox" name="par_outline_level">
                                      <size>150,28</size>
                                      <style>wxCB_READONLY</style>
                                      <content>
                                        <item>Body Text</item>
                                        <item>Level 1</item>
                                        <item>Level 2</item>
                                        <item>Level 3</item>
                                        <item>Level 4</item>
                                        <item>Level 5</item>
                                        <item>Level 6</item>
                                        <item>Level 7</item>
                                        <item>Level 8</item>
                                        <item>Level 9</item>
                                      </content>
                                      <selection>0</selection>
                                    </object>
                                  </object>
                                  <object class="sizeritem">
                                    <option>0</option>
                                    <flag>wxALIGN_CENTER_VERTICAL</flag>
                                    <border>0</border>
                                    <object class="wxStaticText" name="i18n_control_9">
                                      <label>Direction:</label>
                                      <size>86,-1</size>
                                      <fg>#243042</fg>
                                    </object>
                                  </object>
                                  <object class="sizeritem">
                                    <option>0</option>
                                    <flag>wxALIGN_CENTER_VERTICAL</flag>
                                    <border>0</border>
                                    <object class="wxComboBox" name="par_direction">
                                      <size>150,28</size>
                                      <style>wxCB_READONLY</style>
                                      <content>
                                        <item>Automatic</item>
                                        <item>Left-to-right</item>
                                        <item>Right-to-left</item>
                                      </content>
                                      <selection>0</selection>
                                    </object>
                                    <minsize>180,-1</minsize>
                                  </object>
                                  <object class="spacer">
                                    <size>1,1</size>
                                    <option>0</option>
                                  </object>
                                  <object class="sizeritem">
                                    <option>0</option>
                                    <flag>wxALIGN_CENTER_VERTICAL</flag>
                                    <border>0</border>
                                    <object class="wxCheckBox" name="par_collapsed">
                                      <label>Collapsed by default</label>
                                    </object>
                                  </object>
                                </object>
                              </object>
                            </object>
                          </object>
                        </object>
                      </object>
                      <object class="sizeritem">
                        <option>0</option>
                        <flag>wxEXPAND|wxTOP</flag>
                        <border>24</border>
                        <object class="wxBoxSizer">
                          <orient>wxHORIZONTAL</orient>
                          <object class="sizeritem">
                            <option>0</option>
                            <flag>wxALIGN_CENTER_VERTICAL|wxRIGHT</flag>
                            <border>10</border>
                            <object class="wxStaticText" name="i18n_control_12">
                              <label>Indentation</label>
                              <fg>#1d3d78</fg>
