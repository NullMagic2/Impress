                                          <object class="wxStaticText" name="i18n_control_14">
                                            <label>mm</label>
                                            <fg>#6b778a</fg>
                                          </object>
                                        </object>
                                      </object>
                                    </object>
                                    <object class="sizeritem">
                                      <option>0</option>
                                      <flag>wxALIGN_CENTER_VERTICAL</flag>
                                      <border>0</border>
                                      <object class="wxStaticText" name="i18n_control_15">
                                        <label>Relative to</label>
                                        <size>78,-1</size>
                                        <fg>#243042</fg>
                                      </object>
                                    </object>
