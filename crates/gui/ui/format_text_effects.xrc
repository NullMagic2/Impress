<?xml version='1.0' encoding='utf-8'?>
<resource>
  <object class="wxDialog" name="fx_dialog">
    <title>Format Text Effects</title>
    <style>wxDEFAULT_DIALOG_STYLE</style>
    <bg>#e8ecf2</bg>
    <object class="wxBoxSizer">
      <orient>wxVERTICAL</orient>
      <object class="sizeritem">
        <option>0</option>
        <flag>wxLEFT|wxRIGHT|wxTOP</flag>
        <border>12</border>
        <object class="wxBoxSizer">
          <orient>wxHORIZONTAL</orient>
          <object class="spacer">
            <size>8,1</size>
            <option>0</option>
          </object>
          <object class="sizeritem">
            <option>0</option>
            <flag>wxALIGN_BOTTOM</flag>
            <border>0</border>
            <object class="wxButton" name="fx_tab_0">
              <label>Text Fill &amp; Outline</label>
              <size>149,30</size>
              <style>wxBU_EXACTFIT|wxBORDER_NONE</style>
              <bg>#e8ecf2</bg>
            </object>
          </object>
          <object class="sizeritem">
            <option>0</option>
            <flag>wxALIGN_BOTTOM</flag>
            <border>0</border>
            <object class="wxButton" name="fx_tab_1">
              <label>Text Effects</label>
              <size>100,30</size>
              <style>wxBU_EXACTFIT|wxBORDER_NONE</style>
              <bg>#e8ecf2</bg>
            </object>
          </object>
        </object>
      </object>
      <object class="sizeritem">
        <option>1</option>
        <flag>wxEXPAND|wxLEFT|wxRIGHT</flag>
        <border>12</border>
        <object class="wxPanel" name="fx_card">
          <bg>#ffffff</bg>
          <object class="wxBoxSizer">
            <orient>wxVERTICAL</orient>
            <object class="sizeritem">
              <option>1</option>
              <flag>wxEXPAND|wxALL</flag>
              <border>16</border>
              <object class="wxBoxSizer">
                <orient>wxVERTICAL</orient>
                <object class="sizeritem">
                  <option>1</option>
                  <flag>wxEXPAND</flag>
                  <border>0</border>
                  <object class="wxPanel" name="fx_page_0">
                    <bg>#ffffff</bg>
                    <object class="wxBoxSizer">
                      <orient>wxVERTICAL</orient>
                      <object class="sizeritem">
                        <option>0</option>
                        <flag>wxEXPAND</flag>
                        <border>0</border>
                        <object class="wxBoxSizer">
                          <orient>wxHORIZONTAL</orient>
                          <object class="sizeritem">
                            <option>0</option>
                            <flag>wxALIGN_CENTER_VERTICAL|wxRIGHT</flag>
                            <border>10</border>
                            <object class="wxStaticText" name="i18n_control_4">
                              <label>Text Fill</label>
                              <fg>#1d3d78</fg>
                              <font>
                                <weight>bold</weight>
                              </font>
                            </object>
                          </object>
                          <object class="sizeritem">
                            <option>1</option>
                            <flag>wxALIGN_CENTER_VERTICAL</flag>
                            <border>0</border>
                            <object class="wxPanel">
                              <size>-1,1</size>
                              <bg>#dfe4ec</bg>
                            </object>
                          </object>
                        </object>
                      </object>
                      <object class="sizeritem">
                        <option>0</option>
                        <flag>wxEXPAND|wxTOP</flag>
                        <border>10</border>
                        <object class="wxBoxSizer">
                          <orient>wxHORIZONTAL</orient>
                          <object class="spacer">
                            <size>12,1</size>
                            <option>0</option>
                          </object>
                          <object class="sizeritem">
                            <option>1</option>
                            <flag>wxEXPAND</flag>
                            <border>0</border>
                            <object class="wxBoxSizer">
                              <orient>wxVERTICAL</orient>
                              <object class="sizeritem">
                                <option>0</option>
                                <flag>wxEXPAND</flag>
                                <border>0</border>
                                <object class="wxFlexGridSizer">
                                  <rows>0</rows>
                                  <cols>3</cols>
                                  <vgap>8</vgap>
                                  <hgap>32</hgap>
                                  <growablecols />
                                  <object class="sizeritem">
                                    <option>0</option>
                                    <flag>wxALIGN_CENTER_VERTICAL</flag>
                                    <border>0</border>
                                    <object class="wxRadioButton" name="fx_fill_none">
                                      <label>No fill</label>
                                      <style>wxRB_GROUP</style>
                                    </object>
                                  </object>
                                  <object class="sizeritem">
                                    <option>0</option>
                                    <flag>wxALIGN_CENTER_VERTICAL</flag>
                                    <border>0</border>
                                    <object class="wxRadioButton" name="fx_fill_solid">
                                      <label>Solid fill</label>
                                    </object>
                                  </object>
                                  <object class="sizeritem">
                                    <option>0</option>
                                    <flag>wxALIGN_CENTER_VERTICAL</flag>
                                    <border>0</border>
                                    <object class="wxRadioButton" name="fx_fill_gradient">
                                      <label>Gradient fill</label>
                                    </object>
                                  </object>
                                </object>
                              </object>
                              <object class="sizeritem">
                                <option>0</option>
                                <flag>wxEXPAND|wxTOP</flag>
                                <border>10</border>
                                <object class="wxFlexGridSizer">
                                  <rows>0</rows>
                                  <cols>4</cols>
                                  <vgap>8</vgap>
                                  <hgap>12</hgap>
                                  <growablecols />
                                  <object class="sizeritem">
                                    <option>0</option>
                                    <flag>wxALIGN_CENTER_VERTICAL</flag>
                                    <border>0</border>
                                    <object class="wxStaticText" name="i18n_control_8">
                                      <label>Color:</label>
                                      <size>96,-1</size>
                                      <fg>#243042</fg>
                                    </object>
                                  </object>
                                  <object class="sizeritem">
                                    <option>0</option>
                                    <flag>wxALIGN_CENTER_VERTICAL</flag>
                                    <border>0</border>
                                    <object class="wxBitmapComboBox" name="fx_fill_color">
                                      <size>150,28</size>
                                      <style>wxCB_READONLY</style>
                                    </object>
                                    <minsize>190,-1</minsize>
                                  </object>
                                  <object class="sizeritem">
                                    <option>0</option>
                                    <flag>wxALIGN_CENTER_VERTICAL|wxLEFT</flag>
                                    <border>24</border>
                                    <object class="wxStaticText" name="i18n_control_9">
                                      <label>Transparency:</label>
                                      <size>96,-1</size>
                                      <fg>#243042</fg>
                                    </object>
                                  </object>
                                  <object class="sizeritem">
                                    <option>0</option>
                                    <flag>wxALIGN_CENTER_VERTICAL</flag>
                                    <border>0</border>
                                    <object class="wxBoxSizer">
                                      <orient>wxHORIZONTAL</orient>
                                      <object class="sizeritem">
                                        <option>0</option>
                                        <flag>wxALIGN_CENTER_VERTICAL</flag>
                                        <border>0</border>
                                        <object class="wxSpinCtrlDouble" name="fx_fill_transparency">
                                          <size>80,28</size>
                                          <min>0</min>
                                          <max>100</max>
                                          <inc>1</inc>
                                          <digits>0</digits>
                                          <value>0</value>
                                        </object>
                                      </object>
                                      <object class="sizeritem">
                                        <option>0</option>
                                        <flag>wxALIGN_CENTER_VERTICAL|wxLEFT</flag>
                                        <border>6</border>
                                        <object class="wxStaticText" name="i18n_control_10">
                                          <label>%</label>
                                          <fg>#6b778a</fg>
                                        </object>
                                      </object>
                                    </object>
                                  </object>
                                </object>
                              </object>
                            </object>
                          </object>
                        </object>
                      </object>
                      <object class="sizeritem">
                        <option>0</option>
                        <flag>wxEXPAND|wxTOP</flag>
                        <border>24</border>
                        <object class="wxBoxSizer">
                          <orient>wxHORIZONTAL</orient>
                          <object class="sizeritem">
                            <option>0</option>
                            <flag>wxALIGN_CENTER_VERTICAL|wxRIGHT</flag>
                            <border>10</border>
                            <object class="wxStaticText" name="i18n_control_11">
                              <label>Text Outline</label>
