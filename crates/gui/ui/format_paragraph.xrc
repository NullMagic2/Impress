                                    <border>0</border>
                                    <object class="wxBoxSizer">
                                      <orient>wxHORIZONTAL</orient>
                                      <object class="sizeritem">
                                        <option>0</option>
                                        <flag>wxALIGN_CENTER_VERTICAL</flag>
                                        <border>0</border>
                                        <object class="wxSpinCtrlDouble" name="par_right">
                                          <size>90,28</size>
                                          <min>-600</min>
                                          <max>600</max>
                                          <inc>0.5</inc>
                                          <digits>1</digits>
                                          <value>0</value>
                                        </object>
                                      </object>
                                      <object class="sizeritem">
                                        <option>0</option>
                                        <flag>wxALIGN_CENTER_VERTICAL|wxLEFT</flag>
                                        <border>6</border>
                                        <object class="wxStaticText" name="i18n_control_18">
                                          <label>mm</label>
                                          <fg>#6b778a</fg>
                                        </object>
                                      </object>
                                    </object>
