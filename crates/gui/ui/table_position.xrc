<?xml version='1.0' encoding='utf-8'?>
<resource>
  <object class="wxDialog" name="tpos_dialog">
    <title>Table Position</title>
    <style>wxDEFAULT_DIALOG_STYLE</style>
    <bg>#e8ecf2</bg>
    <object class="wxBoxSizer">
      <orient>wxVERTICAL</orient>
      <object class="sizeritem">
        <option>1</option>
        <flag>wxEXPAND|wxLEFT|wxRIGHT|wxTOP</flag>
        <border>12</border>
        <object class="wxPanel" name="tpos_card">
          <bg>#ffffff</bg>
          <object class="wxBoxSizer">
            <orient>wxVERTICAL</orient>
            <object class="sizeritem">
              <option>1</option>
              <flag>wxEXPAND|wxALL</flag>
              <border>16</border>
              <object class="wxBoxSizer">
                <orient>wxVERTICAL</orient>
                <object class="sizeritem">
                  <option>1</option>
                  <flag>wxEXPAND</flag>
                  <border>0</border>
                  <object class="wxBoxSizer">
                    <orient>wxHORIZONTAL</orient>
                    <object class="sizeritem">
                      <option>0</option>
                      <flag>wxEXPAND|wxRIGHT</flag>
                      <border>20</border>
                      <object class="wxBoxSizer">
                        <orient>wxVERTICAL</orient>
                        <object class="sizeritem">
                          <option>0</option>
                          <flag>wxBOTTOM</flag>
                          <border>6</border>
                          <object class="wxStaticText" name="tpos_preview_caption">
                            <label>Preview</label>
                            <fg>#6b778a</fg>
                          </object>
                        </object>
                        <object class="sizeritem">
                          <option>1</option>
                          <flag>wxEXPAND</flag>
                          <border>0</border>
                          <object class="wxPanel" name="tpos_preview">
                            <bg>#eef2f7</bg>
                            <size>190,250</size>
                            <style>wxWANTS_CHARS|wxFULL_REPAINT_ON_RESIZE</style>
                          </object>
                        </object>
                      </object>
                    </object>
                    <object class="sizeritem">
                      <option>1</option>
                      <flag>wxEXPAND</flag>
                      <border>0</border>
                      <object class="wxBoxSizer">
                        <orient>wxVERTICAL</orient>
                        <object class="sizeritem">
                          <option>0</option>
                          <flag>wxEXPAND</flag>
                          <border>0</border>
                          <object class="wxBoxSizer">
                            <orient>wxHORIZONTAL</orient>
                            <object class="sizeritem">
                              <option>0</option>
                              <flag>wxALIGN_CENTER_VERTICAL|wxRIGHT</flag>
                              <border>10</border>
                              <object class="wxStaticText" name="i18n_control_3">
                                <label>Horizontal</label>
                                <fg>#1d3d78</fg>
                                <font>
                                  <weight>bold</weight>
                                </font>
                              </object>
                            </object>
                            <object class="sizeritem">
                              <option>1</option>
                              <flag>wxALIGN_CENTER_VERTICAL</flag>
                              <border>0</border>
                              <object class="wxPanel">
                                <size>-1,1</size>
                                <bg>#dfe4ec</bg>
                              </object>
                            </object>
                          </object>
                        </object>
                        <object class="sizeritem">
                          <option>0</option>
                          <flag>wxEXPAND|wxTOP</flag>
                          <border>10</border>
                          <object class="wxBoxSizer">
                            <orient>wxHORIZONTAL</orient>
                            <object class="spacer">
                              <size>12,1</size>
                              <option>0</option>
                            </object>
                            <object class="sizeritem">
                              <option>1</option>
                              <flag>wxEXPAND</flag>
                              <border>0</border>
                              <object class="wxBoxSizer">
                                <orient>wxVERTICAL</orient>
                                <object class="sizeritem">
                                  <option>0</option>
                                  <flag>wxEXPAND</flag>
                                  <border>0</border>
                                  <object class="wxFlexGridSizer">
                                    <rows>0</rows>
                                    <cols>4</cols>
                                    <vgap>8</vgap>
                                    <hgap>12</hgap>
                                    <growablecols />
                                    <object class="sizeritem">
                                      <option>0</option>
                                      <flag>wxALIGN_CENTER_VERTICAL</flag>
                                      <border>0</border>
                                      <object class="wxStaticText" name="i18n_control_4">
                                        <label>Position</label>
                                        <size>78,-1</size>
                                        <fg>#243042</fg>
                                      </object>
                                    </object>
                                    <object class="sizeritem">
                                      <option>0</option>
                                      <flag>wxALIGN_CENTER_VERTICAL</flag>
                                      <border>0</border>
                                      <object class="wxComboBox" name="tpos_h_mode">
                                        <size>150,28</size>
                                        <style>wxCB_READONLY</style>
                                        <content>
                                          <item>Offset</item>
                                          <item>Left</item>
                                          <item>Center</item>
                                          <item>Right</item>
                                          <item>Inside</item>
                                          <item>Outside</item>
                                        </content>
                                        <selection>0</selection>
                                      </object>
                                      <minsize>150,-1</minsize>
                                    </object>
                                    <object class="sizeritem">
                                      <option>0</option>
                                      <flag>wxALIGN_CENTER_VERTICAL|wxLEFT</flag>
                                      <border>24</border>
                                      <object class="wxStaticText" name="i18n_control_6">
                                        <label>Offset</label>
                                        <fg>#243042</fg>
                                      </object>
                                    </object>
                                    <object class="sizeritem">
                                      <option>0</option>
                                      <flag>wxALIGN_CENTER_VERTICAL</flag>
                                      <border>0</border>
                                      <object class="wxBoxSizer">
                                        <orient>wxHORIZONTAL</orient>
                                        <object class="sizeritem">
                                          <option>0</option>
                                          <flag>wxALIGN_CENTER_VERTICAL</flag>
                                          <border>0</border>
                                          <object class="wxSpinCtrlDouble" name="tpos_h_value">
                                            <size>130,-1</size>
                                            <min>-500</min>
                                            <max>500</max>
                                            <inc>0.5</inc>
                                            <digits>1</digits>
                                            <value>0</value>
                                          </object>
                                        </object>
                                        <object class="sizeritem">
                                          <option>0</option>
                                          <flag>wxALIGN_CENTER_VERTICAL|wxLEFT</flag>
                                          <border>6</border>
                                          <object class="wxStaticText" name="i18n_control_7">
                                            <label>mm</label>
                                            <fg>#6b778a</fg>
                                          </object>
                                        </object>
                                      </object>
                                    </object>
                                    <object class="sizeritem">
                                      <option>0</option>
                                      <flag>wxALIGN_CENTER_VERTICAL</flag>
                                      <border>0</border>
                                      <object class="wxStaticText" name="i18n_control_8">
                                        <label>Relative to</label>
                                        <size>78,-1</size>
                                        <fg>#243042</fg>
                                      </object>
                                    </object>
                                    <object class="sizeritem">
                                      <option>0</option>
                                      <flag>wxALIGN_CENTER_VERTICAL</flag>
                                      <border>0</border>
                                      <object class="wxComboBox" name="tpos_h_from">
                                        <size>150,28</size>
                                        <style>wxCB_READONLY</style>
                                        <content>
                                          <item>Margin</item>
                                          <item>Page</item>
                                          <item>Column</item>
                                        </content>
                                        <selection>0</selection>
                                      </object>
                                      <minsize>150,-1</minsize>
                                    </object>
                                    <object class="spacer">
                                      <size>1,1</size>
                                      <option>0</option>
                                    </object>
                                    <object class="spacer">
                                      <size>1,1</size>
                                      <option>0</option>
                                    </object>
                                  </object>
                                </object>
                              </object>
                            </object>
                          </object>
                        </object>
                        <object class="sizeritem">
                          <option>0</option>
                          <flag>wxEXPAND|wxTOP</flag>
                          <border>24</border>
                          <object class="wxBoxSizer">
