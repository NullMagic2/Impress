                                          <cols>1</cols>
                                          <vgap>8</vgap>
                                          <hgap>12</hgap>
                                          <growablecols>0</growablecols>
                                          <object class="sizeritem">
                                            <option>0</option>
                                            <flag>wxEXPAND</flag>
                                            <border>0</border>
                                            <object class="wxStaticText" name="i18n_control_6">
                                              <label>Color:</label>
                                              <fg>#243042</fg>
                                            </object>
                                          </object>
                                          <object class="sizeritem">
                                            <option>0</option>
                                            <flag>wxEXPAND</flag>
                                            <border>0</border>
                                            <object class="wxBitmapComboBox" name="bdr_color">
                                              <size>170,28</size>
                                              <style>wxCB_READONLY</style>
                                            </object>
                                          </object>
                                          <object class="sizeritem">
                                            <option>0</option>
                                            <flag>wxEXPAND</flag>
                                            <border>0</border>
                                            <object class="wxStaticText" name="i18n_control_7">
                                              <label>Width:</label>
                                              <fg>#243042</fg>
                                            </object>
                                          </object>
                                          <object class="sizeritem">
                                            <option>0</option>
                                            <flag>wxEXPAND</flag>
                                            <border>0</border>
                                            <object class="wxComboBox" name="bdr_width">
                                              <size>170,28</size>
                                              <style>wxCB_READONLY</style>
                                              <content>
                                                <item>¼ pt</item>
                                                <item>½ pt</item>
                                                <item>¾ pt</item>
                                                <item>1 pt</item>
                                                <item>1½ pt</item>
                                                <item>2¼ pt</item>
                                                <item>3 pt</item>
                                                <item>4½ pt</item>
                                                <item>6 pt</item>
