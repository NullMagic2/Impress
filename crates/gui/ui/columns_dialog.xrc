<?xml version='1.0' encoding='utf-8'?>
<resource>
  <object class="wxDialog" name="col_dialog">
    <title>Columns</title>
    <style>wxDEFAULT_DIALOG_STYLE</style>
    <bg>#e8ecf2</bg>
    <object class="wxBoxSizer">
      <orient>wxVERTICAL</orient>
      <object class="sizeritem">
        <option>1</option>
        <flag>wxEXPAND|wxLEFT|wxRIGHT|wxTOP</flag>
        <border>12</border>
        <object class="wxPanel" name="col_card">
          <bg>#ffffff</bg>
          <object class="wxBoxSizer">
            <orient>wxVERTICAL</orient>
            <object class="sizeritem">
              <option>1</option>
              <flag>wxEXPAND|wxALL</flag>
              <border>16</border>
              <object class="wxBoxSizer">
                <orient>wxVERTICAL</orient>
                <object class="sizeritem">
                  <option>1</option>
                  <flag>wxEXPAND</flag>
                  <border>0</border>
                  <object class="wxBoxSizer">
                    <orient>wxHORIZONTAL</orient>
                    <object class="sizeritem">
                      <option>1</option>
                      <flag>wxEXPAND|wxRIGHT</flag>
                      <border>24</border>
                      <object class="wxBoxSizer">
                        <orient>wxVERTICAL</orient>
                        <object class="sizeritem">
                          <option>0</option>
                          <flag>wxEXPAND</flag>
                          <border>0</border>
                          <object class="wxBoxSizer">
                            <orient>wxHORIZONTAL</orient>
                            <object class="sizeritem">
                              <option>0</option>
                              <flag>wxALIGN_CENTER_VERTICAL|wxRIGHT</flag>
                              <border>10</border>
                              <object class="wxStaticText" name="i18n_control_2">
                                <label>Presets</label>
                                <fg>#1d3d78</fg>
                                <font>
                                  <weight>bold</weight>
                                </font>
                              </object>
                            </object>
                            <object class="sizeritem">
                              <option>1</option>
                              <flag>wxALIGN_CENTER_VERTICAL</flag>
                              <border>0</border>
                              <object class="wxPanel">
                                <size>-1,1</size>
                                <bg>#dfe4ec</bg>
                              </object>
                            </object>
                          </object>
                        </object>
                        <object class="sizeritem">
                          <option>0</option>
                          <flag>wxEXPAND|wxTOP</flag>
                          <border>10</border>
                          <object class="wxBoxSizer">
                            <orient>wxHORIZONTAL</orient>
                            <object class="spacer">
                              <size>12,1</size>
                              <option>0</option>
                            </object>
                            <object class="sizeritem">
                              <option>1</option>
                              <flag>wxEXPAND</flag>
                              <border>0</border>
                              <object class="wxBoxSizer">
                                <orient>wxVERTICAL</orient>
                                <object class="sizeritem">
                                  <option>0</option>
                                  <flag>wxEXPAND</flag>
                                  <border>0</border>
                                  <object class="wxPanel" name="col_presets">
                                    <bg>#ffffff</bg>
                                    <size>350,86</size>
                                    <style>wxWANTS_CHARS|wxFULL_REPAINT_ON_RESIZE</style>
                                  </object>
                                </object>
                                <object class="sizeritem">
                                  <option>0</option>
                                  <flag>wxTOP</flag>
                                  <border>12</border>
                                  <object class="wxBoxSizer">
                                    <orient>wxHORIZONTAL</orient>
                                    <object class="sizeritem">
                                      <option>0</option>
                                      <flag>wxALIGN_CENTER_VERTICAL|wxRIGHT</flag>
                                      <border>8</border>
                                      <object class="wxStaticText" name="i18n_control_3">
                                        <label>Number of columns:</label>
                                        <fg>#243042</fg>
                                      </object>
                                    </object>
                                    <object class="sizeritem">
                                      <option>0</option>
                                      <flag>wxALIGN_CENTER_VERTICAL|wxRIGHT</flag>
                                      <border>24</border>
                                      <object class="wxSpinCtrlDouble" name="col_count">
                                        <size>70,28</size>
                                        <min>1</min>
                                        <max>12</max>
                                        <inc>1</inc>
                                        <digits>0</digits>
                                        <value>1</value>
                                      </object>
                                    </object>
                                    <object class="sizeritem">
                                      <option>0</option>
                                      <flag>wxALIGN_CENTER_VERTICAL</flag>
                                      <border>0</border>
                                      <object class="wxCheckBox" name="col_line">
                                        <label>Line between</label>
                                      </object>
                                    </object>
                                  </object>
                                </object>
                              </object>
                            </object>
