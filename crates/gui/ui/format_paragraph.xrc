                                      <object class="sizeritem">
                                        <option>0</option>
                                        <flag>wxALIGN_CENTER_VERTICAL</flag>
                                        <border>0</border>
                                        <object class="wxSpinCtrlDouble" name="par_special_by">
                                          <size>90,28</size>
                                          <min>0</min>
                                          <max>600</max>
                                          <inc>0.5</inc>
                                          <digits>1</digits>
