                              <orient>wxVERTICAL</orient>
                              <object class="sizeritem">
                                <option>0</option>
                                <flag>wxEXPAND</flag>
                                <border>0</border>
                                <object class="wxFlexGridSizer">
                                  <rows>0</rows>
                                  <cols>2</cols>
                                  <vgap>8</vgap>
                                  <hgap>12</hgap>
                                  <growablecols />
                                  <object class="sizeritem">
                                    <option>0</option>
                                    <flag>wxALIGN_CENTER_VERTICAL</flag>
                                    <border>0</border>
                                    <object class="wxStaticText" name="i18n_control_31">
                                      <label>Height:</label>
                                      <size>140,-1</size>
                                      <fg>#243042</fg>
                                    </object>
                                  </object>
                                  <object class="sizeritem">
                                    <option>0</option>
                                    <flag>wxALIGN_CENTER_VERTICAL</flag>
                                    <border>0</border>
                                    <object class="wxBoxSizer">
                                      <orient>wxHORIZONTAL</orient>
                                      <object class="sizeritem">
                                        <option>0</option>
                                        <flag>wxALIGN_CENTER_VERTICAL</flag>
                                        <border>0</border>
                                        <object class="wxTextCtrl" name="lay_height">
                                          <size>80,28</size>
                                        </object>
                                      </object>
                                      <object class="sizeritem">
                                        <option>0</option>
                                        <flag>wxALIGN_CENTER_VERTICAL|wxLEFT</flag>
                                        <border>6</border>
                                        <object class="wxStaticText" name="i18n_control_32">
                                          <label>cm</label>
                                          <fg>#6b778a</fg>
                                        </object>
                                      </object>
                                    </object>
                                    <minsize>160,-1</minsize>
                                  </object>
                                  <object class="sizeritem">
                                    <option>0</option>
                                    <flag>wxALIGN_CENTER_VERTICAL</flag>
                                    <border>0</border>
                                    <object class="wxStaticText" name="i18n_control_33">
                                      <label>Width:</label>
                                      <size>140,-1</size>
                                      <fg>#243042</fg>
                                    </object>
                                  </object>
                                  <object class="sizeritem">
                                    <option>0</option>
                                    <flag>wxALIGN_CENTER_VERTICAL</flag>
                                    <border>0</border>
                                    <object class="wxBoxSizer">
                                      <orient>wxHORIZONTAL</orient>
                                      <object class="sizeritem">
                                        <option>0</option>
                                        <flag>wxALIGN_CENTER_VERTICAL</flag>
                                        <border>0</border>
                                        <object class="wxTextCtrl" name="lay_width">
                                          <size>80,28</size>
                                        </object>
